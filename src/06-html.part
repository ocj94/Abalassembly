

<!-- ─── TOP NAV (logo + auth only) ─── -->
<nav id="top-nav">
  <!-- LEFT: sidebar toggle -->
  <button class="sidebar-toggle-btn" id="sidebar-toggle" onclick="toggleSidebar()" aria-label="Menu" title="Menu">
    <span></span><span></span><span></span>
  </button>

  <!-- CENTER: ABALASSEMBLY logo -->
  <div class="logo" onclick="showPage('home')">
    <span class="logo-text"><span class="logo-aba">ABALA</span><span class="logo-l">SS</span><span class="logo-one">EMBLY</span></span>
  </div>

  <!-- RIGHT: language + help + auth -->
  <div class="nav-right-group" style="margin-left:auto; display:flex; align-items:center; gap:12px">

    <!-- language selector -->
    <div class="lang-select" id="lang-select" style="display:none"><!-- masque : traduction partielle (menus seulement), a reactiver quand i18n couvrira le jeu -->
      <button class="lang-btn" onclick="toggleLangMenu(event)" aria-label="Changer de langue" title="Langue">
        <span class="lang-flag" id="lang-flag">🇫🇷</span>
        <span class="lang-code" id="lang-code">FR</span>
        <span class="lang-caret">▾</span>
      </button>
      <div class="lang-menu" id="lang-menu"></div>
    </div>

    <!-- help menu -->
    <div class="help-select" id="help-select">
      <button class="help-btn" onclick="toggleHelpMenu(event)" aria-label="Aide" title="Aide">
        <span class="help-icon">❓</span>
        <span class="help-label">Aide</span>
      </button>
      <div class="help-menu" id="help-menu">
        <button class="help-option" onclick="openHelp('question')"><span>💬</span> Poser une question</button>
        <button class="help-option" onclick="openReferralModal()"><span>📨</span> Inviter un ami (+XP)</button>
        <button class="help-option" onclick="openHelp('suggestion')"><span>💡</span> Faire une suggestion</button>
        <button class="help-option" onclick="openHelp('bug')"><span>🐞</span> Signaler un bug</button>
        <button class="help-option" onclick="openHelp('abuse')"><span>🚫</span> Signaler un abus</button>
      </div>
    </div>

    <!-- auth -->
    <div class="nav-auth" id="nav-auth-zone">
      <button class="btn-ghost" onclick="openModal('login')" data-i18n="header.login">Se connecter</button>
      <button class="btn-gold" onclick="openModal('signup')" data-i18n="header.signup">S'enregistrer</button>
    </div>
  </div>
</nav>

<!-- ─── BANNIÈRE DE LANGUE ─── -->
<div id="lang-banner" style="display:none">
  <span class="lang-banner-flag" id="lang-banner-flag">🇬🇧</span>
  <span class="lang-banner-text" id="lang-banner-text"></span>
  <button class="lang-banner-action" id="lang-banner-action">Changer</button>
  <button class="lang-banner-close" onclick="dismissLangBanner()" aria-label="Fermer">✕</button>
</div>

<!-- ─── SIDEBAR (chess.com style) ─── -->
<aside id="sidebar" class="sidebar sidebar-hidden">

  <!-- Nav items -->
  <div class="sidebar-items">

    <div class="sidebar-group-label">🎮 Jouer</div>
    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item active" id="sid-home" onclick="sidebarNav('home',this)">
      <span class="s-icon">🏠</span><span class="s-label" data-i18n="nav.home">Accueil</span>
    </button>
    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-game" onclick="sidebarNav('setup',this)">
      <span class="s-icon"><span class="marble-gold"></span></span><span class="s-label" data-i18n="nav.play">Jouer</span>
    </button>
    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-history" onclick="showPage('historique'); if (window.innerWidth < 600 && typeof closeSidebarMobile==='function') closeSidebarMobile();">
      <span class="s-icon">🕓</span><span class="s-label">Historique</span>
    </button>
    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-corpusstats" onclick="showPage('corpusstats'); if (window.innerWidth < 600 && typeof closeSidebarMobile==='function') closeSidebarMobile();">
      <span class="s-icon">📈</span><span class="s-label">Stats du corpus</span>
    </button>
    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-import" onclick="openApgnImportModal(); if (window.innerWidth < 600 && typeof closeSidebarMobile==='function') closeSidebarMobile();">
      <span class="s-icon">📥</span><span class="s-label">Importer</span>
    </button>
    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-puzzles" onclick="sidebarNav('puzzles',this)">
