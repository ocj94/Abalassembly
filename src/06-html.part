       style="font-size:13px;font-weight:600;color:var(--gold);text-decoration:none;display:flex;align-items:center;gap:6px">
      onlineabalone.wordpress.com
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 10L10 2M10 2H5M10 2V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
