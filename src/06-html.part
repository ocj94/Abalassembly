    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-gym" onclick="sidebarNav('gym',this)">
      <span class="s-icon">🧠</span><span class="s-label">Gym Cerveau</span>
