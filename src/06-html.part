    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-academy" onclick="sidebarNav('academy',this)">
      <span class="s-icon">🎓</span><span class="s-label" data-i18n="nav.academy">Abalone Academy</span>
    </button>
    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-openings" onclick="sidebarNav('openings',this)">
