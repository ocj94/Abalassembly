    <!-- THEME CUSTOMIZER -->
    <details style="margin-bottom:24px;background:var(--surface);border:1px solid var(--border);border-radius:10px;overflow:hidden">
      <summary style="padding:16px 20px;font-size:14px;font-weight:600;color:var(--white);cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between">
        🎨 Personnaliser le plateau
        <span style="font-size:12px;color:var(--muted);font-weight:400">Couleurs, thème, pièces</span>
      </summary>
      <div style="padding:20px;border-top:1px solid var(--border)">
        <div style="margin-bottom:20px">
          <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:10px">Style des billes</div>
          <div class="skin-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px"></div>
        </div>
        <div>
          <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">Thème plateau</div>
          <div style="display:flex;gap:10px;flex-wrap:wrap">
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('dark',this)" class="bg-swatch active" style="background:linear-gradient(135deg,#1e2b28,#131b19)" title="Obsidian (défaut)"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Obsidian</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('forest',this)" class="bg-swatch" style="background:linear-gradient(135deg,#1a2e1a,#0d1a0d)" title="Forêt"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Forêt</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('ocean',this)" class="bg-swatch" style="background:linear-gradient(135deg,#0d1a2e,#071020)" title="Océan"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Océan</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('marble',this)" class="bg-swatch" style="background:linear-gradient(135deg,#2a2a2a,#1a1a1a)" title="Marbre"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Marbre</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('gold',this)" class="bg-swatch" style="background:linear-gradient(135deg,#2e200a,#1a1005)" title="Or"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Or</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('wood',this)" class="bg-swatch" style="background:linear-gradient(135deg,#a9763f,#1f6fb0)" title="Bois &amp; résine époxy"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Bois &amp; résine</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('volcanique',this)" class="bg-swatch" style="background:linear-gradient(135deg,#9c6030,#141414)" title="Volcanique"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Volcanique</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('metal',this)" class="bg-swatch" style="background:linear-gradient(135deg,#c8ccd1,#4a4e54)" title="Métal (acier brossé)"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Métal</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('bronze',this)" class="bg-swatch" style="background:linear-gradient(135deg,#b98a4a,#241a0c)" title="Bronze"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Bronze</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('cuivre',this)" class="bg-swatch" style="background:linear-gradient(135deg,#c97a4a,#2c150c)" title="Cuivre"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Cuivre</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('ardoise',this)" class="bg-swatch" style="background:linear-gradient(135deg,#5c6a72,#161b1e)" title="Ardoise"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Ardoise</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('granite',this)" class="bg-swatch" style="background:linear-gradient(135deg,#8a8a90,#1e1e22)" title="Granite"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Granite</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('verre',this)" class="bg-swatch" style="background:linear-gradient(135deg,#bfe4f0,#0a1a24)" title="Verre"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Verre</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('beton',this)" class="bg-swatch" style="background:linear-gradient(135deg,#9a988e,#1c1c1a)" title="Béton"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Béton</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('corail',this)" class="bg-swatch" style="background:linear-gradient(135deg,#e28a7a,#2a0e16)" title="Corail"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Corail</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('glace',this)" class="bg-swatch" style="background:linear-gradient(135deg,#dff4f8,#0a1e26)" title="Glace"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Glace</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('carbone',this)" class="bg-swatch" style="background:linear-gradient(135deg,#38383e,#050506)" title="Carbone (laque noire)"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Carbone</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('onyx',this)" class="bg-swatch" style="background:linear-gradient(135deg,#ff8c00,#0a0500)" title="Onyx doré"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Onyx</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('jade',this)" class="bg-swatch" style="background:linear-gradient(135deg,#4a8a4a,#0a1208)" title="Jade"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Jade</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('stardust',this)" class="bg-swatch" style="background:linear-gradient(135deg,#7a8aaa,#0a0a1a)" title="Poussière d'étoiles"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Stardust</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('terracotta',this)" class="bg-swatch" style="background:linear-gradient(135deg,#ba7a5a,#2a1005)" title="Terre cuite"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Terracotta</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('banquise',this)" class="bg-swatch" style="background:linear-gradient(135deg,#7ab0d0,#0a1a2a)" title="Banquise"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Banquise</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('nacre',this)" class="bg-swatch" style="background:linear-gradient(135deg,#b098c8,#1a0a2a)" title="Nacre"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Nacre</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('patina',this)" class="bg-swatch" style="background:linear-gradient(135deg,#6a9a7a,#0a0a08)" title="Cuivre patiné"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Patine</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('desert',this)" class="bg-swatch" style="background:linear-gradient(135deg,#c89860,#1a1008)" title="Désert de sable"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Désert</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('abyss',this)" class="bg-swatch" style="background:linear-gradient(135deg,#2a6a8a,#04080c)" title="Abysses"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Abysses</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('lava',this)" class="bg-swatch" style="background:linear-gradient(135deg,#e86040,#0a0202)" title="Lave"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Lave</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('marble_white',this)" class="bg-swatch" style="background:linear-gradient(135deg,#b0b0b0,#2a2a2a)" title="Marbre blanc"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Marbre blanc</span>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:4px;width:60px">
              <button onclick="setBoardTheme('pastel',this)" class="bg-swatch" style="background:linear-gradient(135deg,#d0b0d0,#1a1a20)" title="Pastel"></button>
              <span style="font-size:10px;color:var(--muted);text-align:center;line-height:1.2">Pastel</span>
            </div>
          </div>
          <div style="font-size:11px;color:var(--muted);margin-top:8px;line-height:1.5">Chaque thème change réellement la couleur du plateau — feutre, gouttière et contour — aussi bien en 2D qu'en 3D.</div>
          <!-- Jour/Nuit : pour l'instant, seul Volcanique a une variante nuit
               (les 5 autres viendront plus tard, un par un — demande
               d'Olivier). toggleThemeNight() previent clairement si le
               theme actif n'en a pas encore. -->
          <div style="margin-top:10px">
            <button onclick="toggleThemeNight()" id="theme-night-toggle" class="btn-ghost"
              style="padding:5px 12px;font-size:12px;font-weight:600;border:1px solid var(--border);border-radius:8px;cursor:pointer;background:none;color:var(--muted)">🌗 Jour / Nuit</button>
          </div>
        </div>

        <!-- ══ CREATEUR DE PLATEAU ══
             Un thème perso n'est jamais un nouveau code : c'est UNE recette
             de plus (baseTemplate + reglages), executee par le meme moteur
             de couches que les 16 themes integres (window.LAYER_TYPES /
             window.THEME_RECIPES, v1.46). Les curseurs "densite" et
             "intensite" ne touchent a AUCUN theme existant : ils
             post-traitent la liste de couches renvoyee par la recette de
             base choisie (multiplient n et les canaux alpha), donc
             marchent identiquement sur les 16 recettes sans code special
             par theme. La 3D en herite automatiquement, exactement comme
             les 10 themes de la v1.48 — meme THEME_RECIPES consulte des
             deux cotes. -->
        <details style="margin-top:16px;background:rgba(0,0,0,0.15);border:1px solid var(--border);border-radius:10px;overflow:hidden" ontoggle="if(this.open && typeof creatorInit3DPreview==='function') creatorInit3DPreview()">
          <summary style="padding:14px 18px;font-size:13px;font-weight:600;color:var(--white);cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between">
            🧪 Créateur de plateau
            <span style="font-size:11px;color:var(--muted);font-weight:400">Base + couleurs + densité — aperçu en direct</span>
          </summary>
          <div style="padding:18px;border-top:1px solid var(--border);display:flex;gap:20px;flex-wrap:wrap">
            <div style="flex:0 0 200px">
              <canvas id="creator-preview" width="200" height="200" style="width:200px;height:200px;border-radius:12px;border:1px solid var(--border);display:block"></canvas>
              <div style="font-size:10px;color:var(--muted);margin-top:6px;text-align:center">Aperçu 2D</div>
              <div id="creator-preview-3d-wrap" style="position:relative;width:200px;height:200px;margin-top:10px;border-radius:12px;border:1px solid var(--border);overflow:hidden;background:#14141a">
                <canvas id="creator-preview-3d-canvas" width="200" height="200" style="width:200px;height:200px;display:block"></canvas>
                <div id="creator-3d-loader" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:11px;text-align:center;padding:10px">Ouvre le panneau pour charger l'aperçu 3D…</div>
              </div>
              <div style="font-size:10px;color:var(--muted);margin-top:6px;text-align:center">Aperçu 3D — même recette, même moteur</div>
            </div>
            <div style="flex:1;min-width:220px;display:flex;flex-direction:column;gap:12px">
              <div>
                <label style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px">Thème de base</label>
                <select id="creator-base" onchange="creatorUpdate()" style="width:100%;margin-top:4px;padding:7px 10px;background:var(--bg);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:13px">
                  <option value="dark">Obsidian</option>
                  <option value="forest">Forêt</option>
                  <option value="ocean">Océan</option>
                  <option value="marble">Marbre</option>
                  <option value="gold">Or</option>
                  <option value="volcanique">Volcanique</option>
                  <option value="metal">Métal</option>
                  <option value="bronze">Bronze</option>
                  <option value="cuivre">Cuivre</option>
                  <option value="ardoise">Ardoise</option>
                  <option value="granite">Granite</option>
                  <option value="verre">Verre</option>
                  <option value="beton">Béton</option>
                  <option value="corail">Corail</option>
                  <option value="glace">Glace</option>
                  <option value="carbone">Carbone</option>
                  <option value="onyx">Onyx</option>
                  <option value="jade">Jade</option>
                  <option value="stardust">Stardust</option>
                  <option value="terracotta">Terracotta</option>
                  <option value="banquise">Banquise</option>
                  <option value="nacre">Nacre</option>
                  <option value="patina">Cuivre patiné</option>
                  <option value="desert">Désert</option>
                  <option value="abyss">Abysses</option>
                  <option value="lava">Lave</option>
                  <option value="marble_white">Marbre blanc</option>
                  <option value="pastel">Pastel</option>
                </select>
              </div>
              <div style="display:flex;gap:12px">
                <div style="flex:1">
                  <label style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px">Teinte claire</label>
                  <input type="color" id="creator-c1" onchange="creatorUpdate()" style="width:100%;height:32px;margin-top:4px;border-radius:6px;border:1px solid var(--border);background:none;cursor:pointer">
                </div>
                <div style="flex:1">
                  <label style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px">Teinte sombre</label>
                  <input type="color" id="creator-c2" onchange="creatorUpdate()" style="width:100%;height:32px;margin-top:4px;border-radius:6px;border:1px solid var(--border);background:none;cursor:pointer">
                </div>
                <div style="flex:1">
                  <label style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px">Gouttière</label>
                  <input type="color" id="creator-gutter" onchange="creatorUpdate()" style="width:100%;height:32px;margin-top:4px;border-radius:6px;border:1px solid var(--border);background:none;cursor:pointer">
                </div>
              </div>
              <div>
                <label style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px">Densité de la texture — <span id="creator-densite-val">100%</span></label>
                <input type="range" id="creator-densite" min="20" max="220" value="100" oninput="creatorUpdate()" style="width:100%;accent-color:var(--gold);margin-top:4px">
              </div>
              <div>
                <label style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px">Intensité — <span id="creator-intensite-val">100%</span></label>
                <input type="range" id="creator-intensite" min="20" max="220" value="100" oninput="creatorUpdate()" style="width:100%;accent-color:var(--gold);margin-top:4px">
              </div>
              <div style="display:flex;gap:8px;margin-top:6px">
                <button onclick="creatorApply()" class="ctrl-btn primary" style="flex:1">Appliquer au plateau</button>
                <button onclick="creatorReset()" class="ctrl-btn outline">↺ Réinitialiser</button>
              </div>
              <div style="font-size:11px;color:var(--muted)">Le thème personnalisé est sauvegardé automatiquement et reste disponible à la prochaine visite (bouton « Perso » à côté des autres thèmes une fois appliqué).</div>
            </div>
          </div>
        </details>
        <div style="margin-top:16px;display:flex;gap:10px;align-items:center">
          <label style="font-size:13px;color:var(--muted);display:flex;align-items:center;gap:8px;cursor:pointer">
            <input type="checkbox" id="show-coords-toggle" onchange="toggleBoardCoords(this.checked)" style="accent-color:var(--gold)">
            Afficher les coordonnées (A1-I9)
          </label>
          <label style="font-size:13px;color:var(--muted);display:flex;align-items:center;gap:8px;cursor:pointer">
            <input type="checkbox" id="show-hints-toggle" checked onchange="toggleMoveHints(this.checked)" style="accent-color:var(--gold)">
            Afficher les cases jouables
          </label>
          <label style="font-size:13px;color:var(--muted);display:flex;align-items:center;gap:8px;cursor:pointer">
            <input type="checkbox" id="show-last-arrow-toggle" checked onchange="toggleLastMoveArrow(this.checked)" style="accent-color:var(--gold)">
            Afficher la flèche du dernier coup
          </label>
          <label style="font-size:13px;color:var(--muted);display:flex;align-items:center;gap:8px;cursor:pointer">
            <input type="checkbox" id="show-threats-toggle" onchange="toggleThreats(this.checked)" style="accent-color:var(--gold)">
            Afficher les menaces d'éjection (billes en danger)
          </label>
          <label style="font-size:13px;color:var(--muted);display:flex;align-items:center;gap:8px;cursor:pointer">
            <input type="checkbox" id="show-carte-tactique-toggle" onchange="toggleCarteTactiqueOverlay(this.checked)" style="accent-color:var(--gold)">
            Afficher la carte tactique sur le plateau (mobilité, soutien, menace, bord)
          </label>
          <div id="carte-tactique-overlay-dims" style="display:flex;gap:4px;margin:2px 0 4px 28px;flex-wrap:wrap">
            <button type="button" class="carte-overlay-dim-btn setup-opt active" data-dim="menace" style="font-size:10px;padding:3px 8px" onclick="setCarteTactiqueOverlayDim('menace')">Menace</button>
            <button type="button" class="carte-overlay-dim-btn setup-opt" data-dim="mobilite" style="font-size:10px;padding:3px 8px" onclick="setCarteTactiqueOverlayDim('mobilite')">Mobilité</button>
            <button type="button" class="carte-overlay-dim-btn setup-opt" data-dim="soutien" style="font-size:10px;padding:3px 8px" onclick="setCarteTactiqueOverlayDim('soutien')">Soutien</button>
            <button type="button" class="carte-overlay-dim-btn setup-opt" data-dim="bord" style="font-size:10px;padding:3px 8px" onclick="setCarteTactiqueOverlayDim('bord')">Bord</button>
          </div>
          <label style="font-size:13px;color:var(--muted);display:flex;align-items:center;gap:8px;cursor:pointer">
            <input type="checkbox" id="gutter-align-toggle" onchange="setGutterAlign(this.checked ? 'bottom' : 'drop')" style="accent-color:var(--gold)">
            Ranger les billes éjectées en bas de la rigole (sinon : à leur point de sortie)
          </label>
          <div style="margin-top:10px;padding-top:10px;border-top:1px solid var(--border);font-size:11px;color:var(--muted);letter-spacing:0.5px;text-transform:uppercase">Son et vibration, par vue</div>
          <div style="display:grid;grid-template-columns:auto 1fr 1fr;gap:6px 14px;align-items:center;margin-top:6px;font-size:13px;color:var(--muted)">
            <span></span><span style="font-size:11px;text-align:center">Son</span><span style="font-size:11px;text-align:center">Vibration</span>
            <span>1D</span>
            <input type="checkbox" id="avfx-s1d" onchange="setViewSound('1d', this.checked)" style="accent-color:var(--gold);justify-self:center">
            <input type="checkbox" id="avfx-v1d" onchange="setViewVibration('1d', this.checked)" style="accent-color:var(--gold);justify-self:center">
            <span>2D</span>
            <input type="checkbox" id="avfx-s2d" onchange="setViewSound('2d', this.checked)" style="accent-color:var(--gold);justify-self:center">
            <input type="checkbox" id="avfx-v2d" onchange="setViewVibration('2d', this.checked)" style="accent-color:var(--gold);justify-self:center">
            <span>3D</span>
            <input type="checkbox" id="avfx-s3d" onchange="setViewSound('3d', this.checked)" style="accent-color:var(--gold);justify-self:center">
            <input type="checkbox" id="avfx-v3d" onchange="setViewVibration('3d', this.checked)" style="accent-color:var(--gold);justify-self:center">
          </div>
        </div>
      </div>
    </details>

    <div class="profile-grid">
      <div class="profile-card">
        <div class="profile-card-header">
          Historique récent
          <span style="font-size:12px;color:var(--muted)">10 dernières parties</span>
        </div>
        <div class="profile-card-body" id="game-history"></div>
      </div>
      <div class="profile-card">
        <div class="profile-card-header">
          Progression ELO (30 jours)
          <span style="font-size:12px;color:var(--accent-green-light)">+24 pts</span>
        </div>
        <div class="profile-card-body">
          <div class="rating-chart">
            <svg viewBox="0 0 260 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#c8a84b" stop-opacity="0.3"/>
                  <stop offset="100%" stop-color="#c8a84b" stop-opacity="0"/>
                </linearGradient>
              </defs>
              <path d="M0,80 L20,75 L40,70 L60,72 L80,65 L100,60 L120,55 L140,58 L160,50 L180,45 L200,40 L220,35 L240,30 L260,20" fill="none" stroke="#c8a84b" stroke-width="2" stroke-linecap="round"/>
              <path d="M0,80 L20,75 L40,70 L60,72 L80,65 L100,60 L120,55 L140,58 L160,50 L180,45 L200,40 L220,35 L240,30 L260,20 L260,100 L0,100 Z" fill="url(#chartGrad)"/>
            </svg>
          </div>
          <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-top:8px;font-family:'DM Mono',monospace">
            <span>1 Avr</span><span>10 Avr</span><span>20 Avr</span><span>1 Mai</span><span>Auj.</span>
          </div>
          <div style="margin-top:20px">
            <div style="display:flex;justify-content:space-between;margin-bottom:12px">
              <span style="font-size:13px;color:var(--muted)">ELO départ (1 Avr)</span>
              <span style="font-family:'DM Mono',monospace;color:var(--text)">1388</span>
            </div>
            <div style="display:flex;justify-content:space-between;margin-bottom:12px">
              <span style="font-size:13px;color:var(--muted)">ELO maximum</span>
              <span style="font-family:'DM Mono',monospace;color:var(--gold)">1489</span>
            </div>
            <div style="display:flex;justify-content:space-between">
              <span style="font-size:13px;color:var(--muted)">ELO actuel</span>
              <span style="font-family:'DM Mono',monospace;color:var(--muted)">—</span>
            </div>
          </div>
        </div>
      </div>
      <div class="profile-card" style="grid-column:1/-1">
        <div class="profile-card-header">Succès et badges</div>
        <div class="profile-card-body">
          <div class="achievement-grid" id="achievements"></div>
        </div>
      </div>
    </div>
  </div>
  </div><!-- /profile-logged -->
</div><!-- /page-profile -->

<!-- PAGE PARAMETRES -->
<div class="page" id="page-settings">
  <div class="page-header" style="padding-bottom:40px">
    <button onclick="showPage('profile')" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:14px;font-family:'DM Sans',sans-serif;margin-bottom:16px;display:block">&#8592; Retour au profil</button>
    <div class="section-label">Compte et Securite</div>
    <h2>Parametres</h2>
  </div>
  <div style="padding:0 60px 80px;display:grid;grid-template-columns:200px 1fr;gap:40px;max-width:960px">
    <div style="display:flex;flex-direction:column;gap:4px">
      <button onclick="showSettingsTab('general')" class="settings-tab active" id="stab-general">Profil general</button>
      <button onclick="showSettingsTab('security')" class="settings-tab" id="stab-security">Mot de passe</button>
      <button onclick="showSettingsTab('twofa')" class="settings-tab" id="stab-twofa">Double auth.</button>
      <button onclick="showSettingsTab('notifs')" class="settings-tab" id="stab-notifs">Notifications</button>
      <button onclick="showSettingsTab('permissions')" class="settings-tab" id="stab-permissions">🔒 Autorisations</button>
      <button onclick="showSettingsTab('accessibility')" class="settings-tab" id="stab-accessibility">👁 Accessibilité</button>
      <button onclick="showSettingsTab('writer')" class="settings-tab" id="stab-writer" style="display:none;color:#b89ef0;border-left:2px solid #b89ef0">Espace redacteur</button>
      <div style="margin-top:16px;border-top:1px solid var(--border);padding-top:16px">
        <button onclick="logout()" style="width:100%;padding:10px 14px;background:rgba(192,57,43,0.08);border:1px solid rgba(192,57,43,0.25);color:#e05c4b;border-radius:8px;cursor:pointer;font-size:13px;font-family:'DM Sans',sans-serif;text-align:left">Deconnexion</button>
        <button onclick="exportMyData()" style="width:100%;margin-top:8px;padding:10px 14px;background:rgba(74,148,99,0.05);border:1px solid rgba(74,148,99,0.4);color:var(--accent-green-light);border-radius:8px;cursor:pointer;font-size:13px;font-family:'DM Sans',sans-serif;text-align:left">📦 Exporter mes données (JSON)</button>
        <button onclick="importMyData()" style="width:100%;margin-top:8px;padding:10px 14px;background:rgba(200,168,75,0.05);border:1px solid rgba(200,168,75,0.4);color:var(--gold);border-radius:8px;cursor:pointer;font-size:13px;font-family:'DM Sans',sans-serif;text-align:left" title="Restaure une progression exportée sur cet appareil ou un autre">📥 Importer mes données (JSON)</button>
        <button onclick="resetAllData()" style="width:100%;margin-top:8px;padding:10px 14px;background:rgba(192,57,43,0.04);border:1px solid rgba(192,57,43,0.4);color:#e05c4b;border-radius:8px;cursor:pointer;font-size:13px;font-family:'DM Sans',sans-serif;text-align:left">🗑️ Réinitialiser toutes mes données</button>
      </div>
    </div>
    <div>
      <!-- GENERAL -->
      <div class="settings-panel active" id="spanel-general">
        <div style="font-size:18px;font-weight:700;color:var(--white);margin-bottom:20px">Profil general</div>
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;padding:18px;background:var(--surface);border:1px solid var(--border);border-radius:10px">
          <div id="settings-avatar-preview" style="width:64px;height:64px;border-radius:50%;background:#2d5a3d;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:900;font-family:'Playfair Display',serif;color:var(--gold);border:2px solid var(--border);flex-shrink:0">?</div>
          <div>
            <div style="font-size:13px;font-weight:600;color:var(--white);margin-bottom:4px">Couleurs d'avatar disponibles</div>
            <div style="display:flex;gap:6px;flex-wrap:wrap">
              <div onclick="setAvatarColor('#2d5a3d')" style="width:22px;height:22px;border-radius:50%;background:#2d5a3d;cursor:pointer"></div>
              <div onclick="setAvatarColor('#1c3d5a')" style="width:22px;height:22px;border-radius:50%;background:#1c3d5a;cursor:pointer"></div>
              <div onclick="setAvatarColor('#4a1c5a')" style="width:22px;height:22px;border-radius:50%;background:#4a1c5a;cursor:pointer"></div>
              <div onclick="setAvatarColor('#5a1c3d')" style="width:22px;height:22px;border-radius:50%;background:#5a1c3d;cursor:pointer"></div>
              <div onclick="setAvatarColor('#c8a84b')" style="width:22px;height:22px;border-radius:50%;background:#c8a84b;cursor:pointer"></div>
              <div onclick="setAvatarColor('#5a3a1c')" style="width:22px;height:22px;border-radius:50%;background:#5a3a1c;cursor:pointer"></div>
              <div onclick="setAvatarColor('#1c4a4a')" style="width:22px;height:22px;border-radius:50%;background:#1c4a4a;cursor:pointer"></div>
            </div>
          </div>
        </div>
        <div class="form-group"><label class="form-label">Nom d'utilisateur</label><input class="form-input" id="settings-username" placeholder="MonPseudo"></div>
        <div class="form-group"><label class="form-label">Email</label><input class="form-input" id="settings-email" type="email"></div>
        <div class="form-group"><label class="form-label">Pays</label>
          <select class="form-input" id="settings-country" style="cursor:pointer">
            <option value="">Selectionner...</option>
            <option value="FR">France</option><option value="BE">Belgique</option><option value="CH">Suisse</option><option value="DE">Allemagne</option><option value="JP">Japon</option><option value="US">Etats-Unis</option><option value="OTHER">Autre</option>
          </select>
        </div>
        <div class="form-group"><label class="form-label">Biographie</label><textarea class="form-input" id="settings-bio" rows="3" style="resize:vertical;height:80px" placeholder="Quelques mots..."></textarea></div>
        <button class="modal-submit" style="max-width:200px" onclick="saveGeneralSettings()">Enregistrer</button>
      </div>
      <!-- SECURITY -->
      <div class="settings-panel" id="spanel-security">
        <div style="font-size:18px;font-weight:700;color:var(--white);margin-bottom:20px">Changer le mot de passe</div>
        <div class="form-group"><label class="form-label">Mot de passe actuel</label><input class="form-input" id="pw-current" type="password" placeholder="Mot de passe actuel"></div>
        <div class="form-group" style="position:relative"><label class="form-label">Nouveau mot de passe</label><input class="form-input" id="pw-new" type="password" placeholder="Min. 8 caracteres" oninput="checkPwStrength(this.value)" style="padding-right:44px"><button onclick="togglePw('pw-new',this)" style="position:absolute;right:12px;bottom:10px;background:none;border:none;cursor:pointer;color:var(--muted);font-size:16px">&#128065;</button>
          <div id="pw-strength-bar" style="height:3px;border-radius:2px;margin-top:6px;background:var(--border);overflow:hidden"><div id="pw-strength-fill" style="height:100%;width:0%;transition:all 0.3s;border-radius:2px"></div></div>
          <div id="pw-strength-label" style="font-size:11px;color:var(--muted);margin-top:4px"></div>
        </div>
        <div class="form-group"><label class="form-label">Confirmer</label><input class="form-input" id="pw-confirm" type="password" placeholder="Confirmer le mot de passe"></div>
        <button class="modal-submit" style="max-width:220px" onclick="savePassword()">Mettre a jour</button>
      </div>
      <!-- SECURITY STATUS PANEL -->
      <div id="spanel-twofa" class="settings-panel">
        <div style="font-size:18px;font-weight:700;color:var(--white);margin-bottom:16px">Double authentification</div>
        <p style="color:var(--muted);font-size:14px;margin-bottom:20px;line-height:1.7">Activez une ou plusieurs méthodes pour sécuriser votre compte.</p>
        <div style="display:flex;flex-direction:column;gap:10px">
          <div style="display:flex;align-items:center;gap:14px;padding:16px 18px;background:var(--surface);border:1px solid var(--border);border-radius:10px">
            <span style="font-size:22px">📧</span><div style="flex:1"><div style="font-size:14px;font-weight:600;color:var(--white)">Email OTP</div><div style="font-size:12px;color:var(--muted)">Code à 6 chiffres par email</div></div>
            <div id="2fa-status-email" style="font-size:11px;padding:3px 10px;border-radius:20px;background:rgba(107,117,112,0.15);color:var(--muted);border:1px solid var(--border)">Inactif</div>
            <button id="2fa-btn-email" onclick="toggle2FAMethod('email')" style="padding:7px 14px;background:none;border:1px solid var(--border);color:var(--text);border-radius:7px;cursor:pointer;font-size:12px;font-family:'DM Sans',sans-serif">Activer</button>
          </div>
          <div style="display:flex;align-items:center;gap:14px;padding:16px 18px;background:var(--surface);border:1px solid var(--border);border-radius:10px">
            <span style="font-size:22px">📱</span><div style="flex:1"><div style="font-size:14px;font-weight:600;color:var(--white)">SMS</div><div style="font-size:12px;color:var(--muted)">Code par texto</div></div>
            <div id="2fa-status-sms" style="font-size:11px;padding:3px 10px;border-radius:20px;background:rgba(107,117,112,0.15);color:var(--muted);border:1px solid var(--border)">Inactif</div>
            <button id="2fa-btn-sms" onclick="toggle2FAMethod('sms')" style="padding:7px 14px;background:none;border:1px solid var(--border);color:var(--text);border-radius:7px;cursor:pointer;font-size:12px;font-family:'DM Sans',sans-serif">Activer</button>
          </div>
          <div style="display:flex;align-items:center;gap:14px;padding:16px 18px;background:var(--surface);border:1px solid var(--border);border-radius:10px">
            <span style="font-size:22px">🔑</span><div style="flex:1"><div style="font-size:14px;font-weight:600;color:var(--white)">Authenticator (TOTP)</div><div style="font-size:12px;color:var(--muted)">Google Auth, Authy, 1Password</div></div>
            <div id="2fa-status-totp" style="font-size:11px;padding:3px 10px;border-radius:20px;background:rgba(107,117,112,0.15);color:var(--muted);border:1px solid var(--border)">Inactif</div>
            <button id="2fa-btn-totp" onclick="toggle2FAMethod('totp')" style="padding:7px 14px;background:none;border:1px solid var(--border);color:var(--text);border-radius:7px;cursor:pointer;font-size:12px;font-family:'DM Sans',sans-serif">Activer</button>
          </div>
          <div style="display:flex;align-items:center;gap:14px;padding:16px 18px;background:var(--surface);border:1px solid var(--border);border-radius:10px">
            <span style="font-size:22px">🗝</span><div style="flex:1"><div style="font-size:14px;font-weight:600;color:var(--white)">YubiKey FIDO2</div><div style="font-size:12px;color:var(--muted)">Clé de sécurité physique — protection maximale</div></div>
            <div id="2fa-status-yubikey" style="font-size:11px;padding:3px 10px;border-radius:20px;background:rgba(107,117,112,0.15);color:var(--muted);border:1px solid var(--border)">Inactif</div>
            <button id="2fa-btn-yubikey" onclick="toggle2FAMethod('yubikey')" style="padding:7px 14px;background:none;border:1px solid var(--border);color:var(--text);border-radius:7px;cursor:pointer;font-size:12px;font-family:'DM Sans',sans-serif">Activer</button>
          </div>
        </div>

        <!-- Security score -->
        <div style="margin-top:24px;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:20px" id="security-score-panel">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
            <div style="font-size:14px;font-weight:700;color:var(--white)">🛡 Score de sécurité</div>
            <div style="font-family:'DM Mono',monospace;font-size:20px;font-weight:900" id="sec-score-val" style="color:var(--gold)">—</div>
          </div>
          <div style="height:6px;background:var(--border);border-radius:3px;overflow:hidden;margin-bottom:14px">
            <div id="sec-score-bar" style="height:100%;border-radius:3px;transition:width 0.6s ease;width:0%"></div>
          </div>
          <div style="display:flex;flex-direction:column;gap:6px;font-size:13px" id="sec-score-items"></div>
          <button onclick="computeSecurityScore()" style="margin-top:14px;width:100%;padding:9px;background:none;border:1px solid var(--border);color:var(--muted);border-radius:7px;cursor:pointer;font-size:13px;font-family:'DM Sans',sans-serif;transition:all 0.2s" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--border)'">🔄 Recalculer</button>
        </div>

        <!-- Tech info -->
        <div style="margin-top:16px;padding:14px 16px;background:rgba(200,168,75,0.05);border:1px solid rgba(200,168,75,0.15);border-radius:8px;font-size:12px;color:var(--muted);line-height:1.8">
          <div style="font-size:12px;font-weight:600;color:var(--gold);margin-bottom:6px">🔒 Sécurité technique (côté client)</div>
          Stockage : <strong style="color:var(--text)">localStorage chiffré AES-GCM 256 bits</strong><br>
          Mots de passe : <strong style="color:var(--text)">PBKDF2-SHA256 · 100 000 itérations · sel aléatoire</strong><br>
          Sessions : <strong style="color:var(--text)">Token HMAC-SHA256 · expiration 30 jours</strong><br>
          Cookies : <strong style="color:var(--text)">Aucun cookie — 100% localStorage local</strong><br>
          API Web Crypto : <strong style="color:var(--text)">crypto.subtle natif navigateur</strong><br>
          <span style="color:var(--muted);font-style:italic">Portée : protège contre une lecture accidentelle du stockage brut, pas contre un script capable de s'exécuter sur la page (la clé de chiffrement vit dans ce même stockage).</span>
        </div>
      </div>
      <!-- PERMISSIONS -->
      <div class="settings-panel" id="spanel-permissions">
        <div style="font-size:18px;font-weight:700;color:var(--white);margin-bottom:6px">Autorisations</div>
        <p style="color:var(--muted);font-size:14px;margin-bottom:24px;line-height:1.7">Gérez les accès accordés à Abalassembly. Ces permissions sont gérées par votre navigateur et peuvent être modifiées à tout moment.</p>

        <div style="display:flex;flex-direction:column;gap:12px" id="perm-list">

          <!-- MODE ENFANT — protection dédiée, en tête de liste -->
          <div class="perm-card" id="perm-card-kids" style="border-color:rgba(90,180,140,0.35)">
            <div class="perm-left">
              <div class="perm-icon" style="background:rgba(90,180,140,0.12);border-color:rgba(90,180,140,0.3)">🧒</div>
              <div>
                <div class="perm-name">Mode Enfant</div>
                <div class="perm-desc">Plateau aux couleurs vives, pensé pour les petits joueurs. Masque automatiquement le chat, le Labo IA, les réglages et tous les liens externes — pensé pour être sûr pour n'importe quel enfant, pas seulement les vôtres.</div>
                <div class="perm-where" id="kids-mode-status">Actuellement : <strong>désactivé</strong></div>
              </div>
            </div>
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px;flex-shrink:0">
              <button class="perm-btn allow" id="kids-mode-toggle-btn" onclick="toggleKidsMode()">Activer</button>
            </div>
          </div>

          <!-- CAMERA -->
          <div class="perm-card" id="perm-card-camera">
            <div class="perm-left">
              <div class="perm-icon" style="background:rgba(200,168,75,0.1);border-color:rgba(200,168,75,0.2)">📷</div>
              <div>
                <div class="perm-name">Caméra</div>
                <div class="perm-desc">Utilisée pour la détection de plateau en temps réel — page "Détection IA"</div>
                <div class="perm-where">Utilisée dans : <strong>Détection photo / plateau (📷)</strong></div>
              </div>
            </div>
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px;flex-shrink:0">
              <div class="perm-status" id="perm-status-camera">⏳ Non vérifié</div>
              <div style="display:flex;gap:6px">
                <button class="perm-btn allow" onclick="requestPerm('camera')">Autoriser</button>
                <button class="perm-btn deny" onclick="denyPerm('camera')">Refuser</button>
              </div>
            </div>
          </div>

          <!-- MICROPHONE -->
          <div class="perm-card" id="perm-card-micro">
            <div class="perm-left">
              <div class="perm-icon" style="background:rgba(74,148,99,0.1);border-color:rgba(74,148,99,0.2)">🎙️</div>
              <div>
                <div class="perm-name">Microphone</div>
                <div class="perm-desc">Commandes vocales pour déplacer les billes sans toucher l'écran</div>
                <div class="perm-where">Utilisé dans : <strong>Mode Jeu (commandes vocales)</strong></div>
              </div>
            </div>
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px;flex-shrink:0">
              <div class="perm-status" id="perm-status-micro">⏳ Non vérifié</div>
              <div style="display:flex;gap:6px">
                <button class="perm-btn allow" onclick="requestPerm('micro')">Autoriser</button>
                <button class="perm-btn deny" onclick="denyPerm('micro')">Refuser</button>
              </div>
            </div>
          </div>

          <!-- LOCALISATION -->
          <div class="perm-card" id="perm-card-location-removed" style="display:none"></div>

          <!-- CONTACTS -->
          <div class="perm-card" id="perm-card-contacts">
            <div class="perm-left">
              <div class="perm-icon" style="background:rgba(180,100,200,0.1);border-color:rgba(180,100,200,0.2)">👥</div>
              <div>
                <div class="perm-name">Contacts</div>
                <div class="perm-desc">Inviter vos contacts à rejoindre Abalassembly et retrouver des amis déjà inscrits</div>
                <div class="perm-where">Utilisé dans : <strong>Invitations · Amis · Matchmaking</strong></div>
              </div>
            </div>
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px;flex-shrink:0">
              <div class="perm-status" id="perm-status-contacts">⏳ Non vérifié</div>
              <div style="display:flex;gap:6px">
                <button class="perm-btn allow" onclick="requestPerm('contacts')">Autoriser</button>
                <button class="perm-btn deny" onclick="denyPerm('contacts')">Refuser</button>
              </div>
            </div>
          </div>

          <!-- NOTIFICATIONS -->
          <div class="perm-card" id="perm-card-notif">
            <div class="perm-left">
              <div class="perm-icon" style="background:rgba(220,160,60,0.1);border-color:rgba(220,160,60,0.2)">🔔</div>
              <div>
                <div class="perm-name">Notifications push</div>
                <div class="perm-desc">Recevoir des alertes pour vos invitations de parties, résultats et événements même quand le site est fermé</div>
                <div class="perm-where">Utilisées dans : <strong>Invitations · Tournois · Résultats</strong></div>
              </div>
            </div>
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px;flex-shrink:0">
              <div class="perm-status" id="perm-status-notif">⏳ Non vérifié</div>
              <div style="display:flex;gap:6px">
                <button class="perm-btn allow" onclick="requestPerm('notif')">Autoriser</button>
                <button class="perm-btn deny" onclick="denyPerm('notif')">Refuser</button>
              </div>
            </div>
          </div>

        </div>

        <!-- Info browser -->
        <div style="margin-top:24px;padding:16px 20px;background:var(--surface);border:1px solid var(--border);border-radius:10px;display:flex;gap:14px;align-items:flex-start">
          <span style="font-size:20px;flex-shrink:0">ℹ️</span>
          <div style="font-size:13px;color:var(--muted);line-height:1.7">
            Les autorisations sont gérées par votre navigateur. Pour réinitialiser une autorisation refusée, cliquez sur l'icône 🔒 dans la barre d'adresse ou allez dans <strong style="color:var(--text)">Paramètres navigateur → Confidentialité → Autorisations de site</strong>.
          </div>
        </div>

        <!-- CONFORT & ACCESSIBILITE -->
        <div style="margin-top:26px;padding-top:22px;border-top:1px solid var(--border)">
          <div style="font-size:18px;font-weight:700;color:var(--white);margin-bottom:4px">Confort &amp; accessibilité</div>
          <div style="font-size:12px;color:var(--muted);margin-bottom:6px">Des réglages qui changent réellement l'affichage et le rythme du jeu. Rien ici ne prétend soigner quoi que ce soit — ce sont des choix, offerts à qui en a besoin comme à qui les préfère.</div>
          <div id="a11y-panel"></div>
        </div>

        <!-- RÉGLAGES DE JEU : notation, sons, coordonnées (liés au jeu) -->
        <div style="margin-top:26px;padding-top:22px;border-top:1px solid var(--border)">
          <div style="font-size:18px;font-weight:700;color:var(--white);margin-bottom:4px">Réglages de jeu</div>
          <div style="font-size:12px;color:var(--muted);margin-bottom:12px">Notation, sons et coordonnées. Ces préférences valent pour toutes vos parties.</div>

          <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin:8px 0 4px">Sons du jeu</div>
          <label class="setup-toggle">
            <span>Effets sonores lors des coups et captures</span>
            <input type="checkbox" id="settings-sound-toggle" checked onchange="toggleSound(this.checked);syncSoundToggles(this.checked)">
            <span class="setup-sw"></span>
          </label>

          <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin:14px 0 4px">Coordonnées des cases</div>
          <label class="setup-toggle">
            <span>Afficher les repères a1…i9 sur le plateau</span>
            <input type="checkbox" id="settings-coords-toggle" onchange="toggleCoordinates(this.checked);syncCoordsToggles(this.checked)">
            <span class="setup-sw"></span>
          </label>

          <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin:14px 0 4px">Notation des coups</div>
          <label class="setup-toggle">
            <span>Aba-Pro <span style="color:var(--muted);font-size:11px">(e6e8 — officielle)</span></span>
            <input type="checkbox" id="settings-abapro-toggle" checked onchange="toggleNotationAbaPro(this.checked);syncNotationToggles()">
            <span class="setup-sw"></span>
          </label>
          <label class="setup-toggle">
            <span>Nacre <span style="color:var(--muted);font-size:11px">(c3d6 — francophone)</span></span>
            <input type="checkbox" id="settings-nacre-toggle" onchange="toggleNotationNacre(this.checked);syncNotationToggles()">
            <span class="setup-sw"></span>
          </label>
        </div>


        <!-- Refresh button -->
        <button class="modal-submit" style="max-width:220px;margin-top:16px" onclick="checkAllPermissions()">🔄 Vérifier toutes les autorisations</button>
      </div>
        <div style="font-size:18px;font-weight:700;color:var(--white);margin-bottom:20px">Notifications</div>
        <div style="display:flex;flex-direction:column;gap:12px">
          <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px;background:var(--surface);border:1px solid var(--border);border-radius:8px">
            <div><div style="font-size:14px;font-weight:500;color:var(--white)">Invitations de partie</div><div style="font-size:12px;color:var(--muted)">Quand un joueur vous defie</div></div>
            <label class="notif-toggle"><input type="checkbox" checked onchange="this.nextElementSibling.style.background=this.checked?'var(--gold)':'var(--border)'"><span class="notif-toggle-track"></span></label>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px;background:var(--surface);border:1px solid var(--border);border-radius:8px">
            <div><div style="font-size:14px;font-weight:500;color:var(--white)">Fin de partie</div><div style="font-size:12px;color:var(--muted)">Resultats de vos parties</div></div>
            <label class="notif-toggle"><input type="checkbox" checked onchange="this.nextElementSibling.style.background=this.checked?'var(--gold)':'var(--border)'"><span class="notif-toggle-track"></span></label>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px;background:var(--surface);border:1px solid var(--border);border-radius:8px">
            <div><div style="font-size:14px;font-weight:500;color:var(--white)">Evenements et tournois</div><div style="font-size:12px;color:var(--muted)">Annonces de la communaute</div></div>
            <label class="notif-toggle"><input type="checkbox" checked onchange="this.nextElementSibling.style.background=this.checked?'var(--gold)':'var(--border)'"><span class="notif-toggle-track"></span></label>
          </div>
        </div>
        <button class="modal-submit" style="max-width:200px;margin-top:20px" onclick="showToast('Preferences sauvegardees !')">Enregistrer</button>
      </div>
      <!-- ══ ACCESSIBILITÉ & NUANCES ══ -->
      <div class="settings-panel" id="spanel-accessibility">
        <div style="font-size:18px;font-weight:700;color:var(--white);margin-bottom:6px">👁 Accessibilité & Nuances</div>
        <p style="color:var(--muted);font-size:13px;margin-bottom:24px;line-height:1.7">Adaptez l'affichage selon vos besoins visuels. Tous les réglages s'appliquent immédiatement.</p>

        <!-- SECTION: DALTONISME -->
        <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:14px">Mode daltonisme</div>
        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:28px">

          <div class="access-mode-card active" id="amode-none" onclick="setColorMode('none',this)">
            <div style="display:flex;gap:5px;margin-bottom:8px">
              <div style="width:20px;height:20px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#555,#111)"></div>
              <div style="width:20px;height:20px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#fff,#bbb)"></div>
            </div>
            <div style="font-size:13px;font-weight:700;color:var(--white)">Standard</div>
            <div style="font-size:11px;color:var(--muted);margin-top:2px">Noir & Blanc — défaut</div>
          </div>

          <div class="access-mode-card" id="amode-deuteranopia" onclick="setColorMode('deuteranopia',this)">
            <div style="display:flex;gap:5px;margin-bottom:8px">
              <div style="width:20px;height:20px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#4477cc,#1133aa)"></div>
              <div style="width:20px;height:20px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#ffcc44,#cc8800)"></div>
            </div>
            <div style="font-size:13px;font-weight:700;color:var(--white)">Deutéranopie</div>
            <div style="font-size:11px;color:var(--muted);margin-top:2px">Bleu & Jaune — rouge/vert</div>
          </div>

          <div class="access-mode-card" id="amode-protanopia" onclick="setColorMode('protanopia',this)">
            <div style="display:flex;gap:5px;margin-bottom:8px">
              <div style="width:20px;height:20px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#0088cc,#004488)"></div>
              <div style="width:20px;height:20px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#ffaa00,#cc6600)"></div>
            </div>
            <div style="font-size:13px;font-weight:700;color:var(--white)">Protanopie</div>
            <div style="font-size:11px;color:var(--muted);margin-top:2px">Bleu & Orange — déficit rouge</div>
          </div>

          <div class="access-mode-card" id="amode-tritanopia" onclick="setColorMode('tritanopia',this)">
            <div style="display:flex;gap:5px;margin-bottom:8px">
              <div style="width:20px;height:20px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#cc2244,#880022)"></div>
              <div style="width:20px;height:20px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#00ccaa,#008877)"></div>
            </div>
            <div style="font-size:13px;font-weight:700;color:var(--white)">Tritanopie</div>
            <div style="font-size:11px;color:var(--muted);margin-top:2px">Rouge & Cyan — déficit bleu</div>
          </div>

          <div class="access-mode-card" id="amode-monochromacy" onclick="setColorMode('monochromacy',this)">
            <div style="display:flex;gap:5px;margin-bottom:8px">
              <div style="width:20px;height:20px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#222,#000)"></div>
              <div style="width:20px;height:20px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#eee,#999)"></div>
            </div>
            <div style="font-size:13px;font-weight:700;color:var(--white)">Monochromie</div>
            <div style="font-size:11px;color:var(--muted);margin-top:2px">Haut contraste N&B</div>
          </div>

          <div class="access-mode-card" id="amode-shapes" onclick="setColorMode('shapes',this)">
            <div style="display:flex;gap:5px;margin-bottom:8px;align-items:center">
              <div style="width:20px;height:20px;background:#555;clip-path:polygon(50% 0%,100% 100%,0% 100%);border-radius:2px"></div>
              <div style="width:20px;height:20px;border-radius:50%;background:#eee;outline:2px solid #aaa"></div>
            </div>
            <div style="font-size:13px;font-weight:700;color:var(--white)">Formes + Couleurs</div>
            <div style="font-size:11px;color:var(--muted);margin-top:2px">Triangle ▲ / Rond ● distincts</div>
          </div>
        </div>

        <!-- SECTION: CONTRASTE -->
        <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:14px">Contraste & Luminosité</div>
        <div style="display:flex;flex-direction:column;gap:14px;margin-bottom:28px">
          <div>
            <div style="display:flex;justify-content:space-between;margin-bottom:6px">
              <label style="font-size:13px;color:var(--text)">Contraste général</label>
              <span style="font-size:12px;color:var(--gold);font-family:'DM Mono',monospace" id="contrast-val">100%</span>
            </div>
            <input type="range" id="contrast-range" min="80" max="200" value="100" step="5"
              style="width:100%;accent-color:var(--gold);cursor:pointer"
              oninput="applyAccessibility()">
            <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--muted);margin-top:3px"><span>Doux</span><span>Normal</span><span>Élevé</span></div>
          </div>
          <div>
            <div style="display:flex;justify-content:space-between;margin-bottom:6px">
              <label style="font-size:13px;color:var(--text)">Luminosité</label>
              <span style="font-size:12px;color:var(--gold);font-family:'DM Mono',monospace" id="brightness-val">100%</span>
            </div>
            <input type="range" id="brightness-range" min="60" max="140" value="100" step="5"
              style="width:100%;accent-color:var(--gold);cursor:pointer"
              oninput="applyAccessibility()">
            <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--muted);margin-top:3px"><span>Sombre</span><span>Normal</span><span>Clair</span></div>
          </div>
          <div>
            <div style="display:flex;justify-content:space-between;margin-bottom:6px">
              <label style="font-size:13px;color:var(--text)">Saturation des couleurs</label>
              <span style="font-size:12px;color:var(--gold);font-family:'DM Mono',monospace" id="saturation-val">100%</span>
            </div>
            <input type="range" id="saturation-range" min="0" max="200" value="100" step="10"
              style="width:100%;accent-color:var(--gold);cursor:pointer"
              oninput="applyAccessibility()">
            <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--muted);margin-top:3px"><span>Niveaux de gris</span><span>Normal</span><span>Vif</span></div>
          </div>
        </div>

        <!-- SECTION: TEXTE -->
        <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:14px">Taille du texte</div>
        <div style="display:flex;gap:8px;margin-bottom:28px;flex-wrap:wrap">
          <button onclick="setFontSize(85,this)" class="font-size-btn" style="font-size:11px">A<br><span>Petit</span></button>
          <button onclick="setFontSize(100,this)" class="font-size-btn active" style="font-size:13px">A<br><span>Normal</span></button>
          <button onclick="setFontSize(115,this)" class="font-size-btn" style="font-size:15px">A<br><span>Grand</span></button>
          <button onclick="setFontSize(130,this)" class="font-size-btn" style="font-size:17px">A<br><span>Très grand</span></button>
          <button onclick="setFontSize(150,this)" class="font-size-btn" style="font-size:20px">A<br><span>XL</span></button>
        </div>

        <!-- SECTION: ANIMATIONS -->
        <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:14px">Mouvement & Animations</div>
        <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:28px">
          <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px;background:var(--surface);border:1px solid var(--border);border-radius:8px">
            <div>
              <div style="font-size:14px;font-weight:500;color:var(--white)">Réduire les animations</div>
              <div style="font-size:12px;color:var(--muted);margin-top:2px">Désactive les logos animés, transitions, logo 3,2,1</div>
            </div>
            <label style="position:relative;display:inline-block;width:42px;height:24px;flex-shrink:0">
              <input type="checkbox" id="reduce-motion" style="opacity:0;width:0;height:0"
                onchange="toggleReduceMotion(this.checked)">
              <span id="reduce-motion-track" style="position:absolute;inset:0;background:var(--border);border-radius:12px;cursor:pointer;transition:0.2s"></span>
            </label>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px;background:var(--surface);border:1px solid var(--border);border-radius:8px">
            <div>
              <div style="font-size:14px;font-weight:500;color:var(--white)">Mode focus (contours nets)</div>
              <div style="font-size:12px;color:var(--muted);margin-top:2px">Ajoute des bordures visibles sur les éléments cliquables</div>
            </div>
            <label style="position:relative;display:inline-block;width:42px;height:24px;flex-shrink:0">
              <input type="checkbox" id="focus-mode" style="opacity:0;width:0;height:0"
                onchange="toggleFocusMode(this.checked)">
              <span id="focus-mode-track" style="position:absolute;inset:0;background:var(--border);border-radius:12px;cursor:pointer;transition:0.2s"></span>
            </label>
          </div>
        </div>

        <!-- SECTION: PLATEAU -->
        <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:14px">Plateau de jeu</div>
        <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:24px">
          <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px;background:var(--surface);border:1px solid var(--border);border-radius:8px">
            <div>
              <div style="font-size:14px;font-weight:500;color:var(--white)">Afficher les coordonnées (A1–I9)</div>
              <div style="font-size:12px;color:var(--muted);margin-top:2px">Étiquettes de cases sur chaque bille</div>
            </div>
            <label style="position:relative;display:inline-block;width:42px;height:24px;flex-shrink:0">
              <input type="checkbox" id="coords-toggle-acc" style="opacity:0;width:0;height:0"
                onchange="toggleBoardCoords(this.checked);this.nextElementSibling.style.background=this.checked?'var(--gold)':'var(--border)'">
              <span style="position:absolute;inset:0;background:var(--border);border-radius:12px;cursor:pointer;transition:0.2s"></span>
            </label>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px;background:var(--surface);border:1px solid var(--border);border-radius:8px">
            <div>
              <div style="font-size:14px;font-weight:500;color:var(--white)">Agrandir le plateau</div>
              <div style="font-size:12px;color:var(--muted);margin-top:2px">Augmente la taille des billes pour une meilleure visibilité</div>
            </div>
            <label style="position:relative;display:inline-block;width:42px;height:24px;flex-shrink:0">
              <input type="checkbox" id="large-board-toggle" style="opacity:0;width:0;height:0"
                onchange="toggleLargeBoard(this.checked);this.nextElementSibling.style.background=this.checked?'var(--gold)':'var(--border)'">
              <span style="position:absolute;inset:0;background:var(--border);border-radius:12px;cursor:pointer;transition:0.2s"></span>
            </label>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px;background:var(--surface);border:1px solid var(--border);border-radius:8px">
            <div>
              <div style="font-size:14px;font-weight:500;color:var(--white)">Afficher les coups possibles</div>
              <div style="font-size:12px;color:var(--muted);margin-top:2px">Points verts sur les cases accessibles</div>
            </div>
            <label style="position:relative;display:inline-block;width:42px;height:24px;flex-shrink:0">
              <input type="checkbox" id="hints-toggle-acc" checked style="opacity:0;width:0;height:0"
                onchange="showMoveHints=this.checked;if(typeof drawBoard==='function')drawBoard();this.nextElementSibling.style.background=this.checked?'var(--gold)':'var(--border)'">
              <span style="position:absolute;inset:0;background:var(--gold);border-radius:12px;cursor:pointer;transition:0.2s"></span>
            </label>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px;background:var(--surface);border:1px solid var(--border);border-radius:8px">
            <div>
              <div style="font-size:14px;font-weight:500;color:var(--white)">Afficher mes statistiques de performance</div>
              <div style="font-size:12px;color:var(--muted);margin-top:2px">Graphique radar de vos forces et faiblesses sur votre profil</div>
            </div>
            <label style="position:relative;display:inline-block;width:42px;height:24px;flex-shrink:0">
              <input type="checkbox" id="radar-toggle" checked style="opacity:0;width:0;height:0"
                onchange="toggleRadarVisibility(this.checked);this.nextElementSibling.style.background=this.checked?'var(--gold)':'var(--border)'">
              <span style="position:absolute;inset:0;background:var(--gold);border-radius:12px;cursor:pointer;transition:0.2s"></span>
            </label>
          </div>
        </div>

        <!-- Aperçu en direct -->
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:18px;margin-bottom:16px">
          <div style="font-size:12px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:12px">Aperçu en direct</div>
          <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
            <canvas id="access-preview-canvas" width="120" height="120" style="border-radius:8px;flex-shrink:0"></canvas>
            <div>
              <div id="access-mode-label" style="font-size:14px;font-weight:600;color:var(--white);margin-bottom:4px">Mode Standard</div>
              <div id="access-mode-desc" style="font-size:12px;color:var(--muted);line-height:1.6;max-width:220px">Affichage par défaut — billes noires et blanches sans modification.</div>
            </div>
          </div>
        </div>

        <!-- Reset -->
        <button onclick="resetAccessibility()" style="width:100%;padding:11px;background:none;border:1px solid var(--border);color:var(--muted);border-radius:8px;cursor:pointer;font-size:13px;font-family:'DM Sans',sans-serif;transition:all 0.2s" onmouseover="this.style.borderColor='var(--gold)';this.style.color='var(--text)'" onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--muted)'">🔄 Réinitialiser tous les réglages d'accessibilité</button>
      </div>

      <!-- ══ ESPACE RÉDACTEUR ══ -->
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
          <div style="font-size:18px;font-weight:700;color:#b89ef0">Espace Redacteur</div>
          <span style="font-size:10px;padding:2px 8px;background:rgba(138,114,210,0.2);color:#b89ef0;border-radius:8px;font-weight:700">REDACTEUR</span>
        </div>
        <div style="padding:16px 18px;background:rgba(138,114,210,0.06);border:1px solid rgba(138,114,210,0.2);border-radius:10px;margin-bottom:20px">
          <div style="font-size:13px;font-weight:600;color:#b89ef0;margin-bottom:6px">Compte redacteur — FightClub</div>
          <div style="font-size:13px;color:var(--muted);line-height:1.7">Nom reel: Frederic Garnier<br>Blog: onlineabalone.wordpress.com (fondateur 2013)<br>Role: Administrateur principal, redacteur en chef</div>
        </div>
        <div style="display:flex;flex-direction:column;gap:12px">
          <div class="form-group"><label class="form-label">Titre de l'article</label><input class="form-input" id="article-title" placeholder="Ex: Analyse de l'ouverture Daisy..."></div>
          <div class="form-group"><label class="form-label">Categorie</label>
            <select class="form-input" id="article-cat" style="cursor:pointer">
              <option>Abalone Academy</option><option>Variantes</option><option>Problemes mensuels</option><option>Evenements</option><option>Musee</option><option>Strategie</option><option>Histoire du jeu</option>
            </select>
          </div>
          <div class="form-group"><label class="form-label">Contenu de l'article</label><textarea class="form-input" id="article-body" rows="10" style="resize:vertical;min-height:200px;font-family:'DM Mono',monospace;font-size:13px" placeholder="Redigez votre article ici... Markdown supporte.&#10;&#10;## Titre&#10;**Texte en gras**&#10;[Lien](url)"></textarea></div>
          <div style="display:flex;gap:10px;flex-wrap:wrap">
            <button class="modal-submit" style="max-width:180px" onclick="publishArticle()">Publier l'article</button>
            <button style="padding:12px 20px;background:none;border:1px solid var(--border);color:var(--muted);border-radius:8px;cursor:pointer;font-family:'DM Sans',sans-serif;font-size:13px" onclick="showToast('Brouillon sauvegarde')">Sauver brouillon</button>
          </div>
        </div>
        <div style="margin-top:24px;border-top:1px solid var(--border);padding-top:20px">
          <div style="font-size:13px;font-weight:600;color:var(--white);margin-bottom:12px">Articles recents publies</div>
          <div style="display:flex;flex-direction:column;gap:8px" id="writer-articles">
            <div style="padding:12px 14px;background:var(--surface);border:1px solid var(--border);border-radius:8px;display:flex;justify-content:space-between;align-items:center">
              <div><div style="font-size:13px;color:var(--text)">Les configurations bloquees</div><div style="font-size:11px;color:var(--muted)">Abalone Academy - il y a 3 jours</div></div>
              <a href="https://onlineabalone.wordpress.com/abalone-academy/un-peu-de-theorie/les-configurations-bloquees/" target="_blank" rel="noopener noreferrer" style="font-size:12px;color:var(--gold);text-decoration:none">Voir</a>
            </div>
            <div style="padding:12px 14px;background:var(--surface);border:1px solid var(--border);border-radius:8px;display:flex;justify-content:space-between;align-items:center">
              <div><div style="font-size:13px;color:var(--text)">Probleme du mois - Mai 2025</div><div style="font-size:11px;color:var(--muted)">Problemes abaloniens - il y a 1 semaine</div></div>
              <a href="https://onlineabalone.wordpress.com/abalone-academy/problemes-abaloniens/problemes-mensuels/" target="_blank" rel="noopener noreferrer" style="font-size:12px;color:var(--gold);text-decoration:none">Voir</a>
            </div>
            <div style="padding:12px 14px;background:var(--surface);border:1px solid var(--border);border-radius:8px;display:flex;justify-content:space-between;align-items:center">
              <div><div style="font-size:13px;color:var(--text)">Variantes pour 5 et 6 joueurs</div><div style="font-size:11px;color:var(--muted)">Variantes - il y a 2 semaines</div></div>
              <a href="https://onlineabalone.wordpress.com/les-variantes/abalone-multi-joueurs/" target="_blank" rel="noopener noreferrer" style="font-size:12px;color:var(--gold);text-decoration:none">Voir</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════
     PAGE: TOURNOI
══════════════════════════════════════════ -->

<!-- PAGE: ACADEMY -->
<div class="page" id="page-academy">
  <div class="page-header">
    <div class="section-label">Source: <a href="https://onlineabalone.wordpress.com/abalone-academy/" target="_blank" rel="noopener noreferrer" style="color:var(--gold);text-decoration:none">Abalone Academy</a></div>
    <h2>Abalone Academy</h2>
    <p style="color:var(--muted);font-size:15px;margin-top:12px;max-width:560px">Théorie, stratégie, notation — tout pour progresser vraiment.</p>
  </div>
  <div style="padding:0 60px 80px">
    <div style="display:flex;flex-direction:column;gap:0;margin:32px 0 40px">
      <div style="display:grid;grid-template-columns:repeat(3,1fr)">
        <div style="background:var(--surface);border:1px solid var(--border);padding:28px 24px">
          <div style="font-family:'Playfair Display',serif;font-size:48px;font-weight:900;color:rgba(200,168,75,0.15);margin-bottom:6px">1</div>
          <div style="font-size:15px;font-weight:700;color:var(--gold);margin-bottom:8px">Ouverture</div>
          <div style="font-size:13px;color:var(--muted);line-height:1.65">Développement vers le centre. Formations initiales : Marguerite, Daisy, Alien. Conquête sans s'exposer.</div>
        </div>
        <div style="background:var(--surface2);border:1px solid var(--border);border-left:none;padding:28px 24px">
          <div style="font-family:'Playfair Display',serif;font-size:48px;font-weight:900;color:rgba(200,168,75,0.15);margin-bottom:6px">2</div>
          <div style="font-size:15px;font-weight:700;color:var(--gold);margin-bottom:8px">Milieu de partie</div>
          <div style="font-size:13px;color:var(--muted);line-height:1.65">Tension maximale. Échanges, fourchettes, attaques multiples. L'avantage positionnel se décide ici.</div>
        </div>
        <div style="background:var(--surface);border:1px solid var(--border);border-left:none;padding:28px 24px">
          <div style="font-family:'Playfair Display',serif;font-size:48px;font-weight:900;color:rgba(200,168,75,0.15);margin-bottom:6px">3</div>
          <div style="font-size:15px;font-weight:700;color:var(--gold);margin-bottom:8px">Fin de partie</div>
          <div style="font-size:13px;color:var(--muted);line-height:1.65">Poussées décisives. Chaque bille compte. Précision et calcul priment sur la créativité.</div>
        </div>
      </div>
    </div>
    <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:20px">Les 10 Commandements</div>
    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px">
      ${["Vise le centre","Garde tes billes groupées","Évite les bords","Attaque sur 2 fronts","Anticipe les ripostes","Utilise le Sumito","Ne gaspille pas les coups","Connais les positions bloquées","Adapte-toi au style adverse","Joue et rejoue"].map(function(cmd,i){ return '<div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:16px 18px;display:flex;gap:12px;align-items:flex-start"><div style="font-family:Playfair Display,serif;font-size:28px;font-weight:900;color:rgba(200,168,75,0.2);min-width:32px">'+['I','II','III','IV','V','VI','VII','VIII','IX','X'][i]+'</div><div style="font-size:14px;color:var(--text);line-height:1.6">'+cmd+'</div></div>'; }).join('')}
    </div>
    <div style="margin-top:32px;padding:18px 22px;background:rgba(200,168,75,0.06);border:1px solid rgba(200,168,75,0.2);border-radius:8px;font-size:14px;color:var(--text);line-height:1.7">
      📚 Source complète : <a href="https://onlineabalone.wordpress.com/abalone-academy/un-peu-de-theorie/les-dix-commandements-du-joueur-debutant/" target="_blank" rel="noopener noreferrer" style="color:var(--gold)">Abalone Academy — Les 10 commandements</a>
    </div>

    <!-- GERT SCHNIDER — ABA-PRO Expert Analysis -->
    <div style="margin-top:32px">
      <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:16px">Analyse experte — Source : <span style="color:var(--gold)">NACRE-ABAPRO_Game3.ABA · Gert Schnider · ABA-PRO 4.7</span></div>
      <div style="font-family:'Playfair Display',serif;font-size:20px;font-weight:900;color:var(--white);margin-bottom:6px">Leçons de Gert Schnider</div>
      <p style="color:var(--muted);font-size:13px;line-height:1.7;margin-bottom:20px">Commentaires extraits d'une partie annotée par Gert Schnider dans ABA-PRO 4.7 — logiciel de référence historique pour Abalone. Ces observations tactiques proviennent de l'analyse binaire du fichier <code style="background:var(--surface2);padding:1px 6px;border-radius:4px;font-family:'DM Mono',monospace">NACRE-ABAPRO_Game3.ABA</code>.</p>

      <div style="display:flex;flex-direction:column;gap:12px">
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:20px">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
            <div style="width:28px;height:28px;border-radius:6px;background:rgba(200,168,75,0.15);display:flex;align-items:center;justify-content:center;font-size:14px">📖</div>
            <div style="font-size:12px;font-weight:600;color:var(--gold);text-transform:uppercase;letter-spacing:1px">Principe #1 — L'ouverture</div>
          </div>
          <blockquote style="margin:0;font-size:14px;color:var(--text);font-style:italic;line-height:1.7;border-left:3px solid var(--gold);padding-left:14px">"This is the wrong idea — pushing out marbles in the opening is normally misguided."</blockquote>
          <p style="font-size:12px;color:var(--muted);margin-top:10px;line-height:1.6">💡 En ouverture, chercher à éjecter immédiatement est une erreur. L'objectif premier est le <strong style="color:var(--text)">contrôle du centre</strong> et la construction d'une masse cohérente. Les éjections viennent naturellement d'une bonne position.</p>
        </div>

        <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:20px">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
            <div style="width:28px;height:28px;border-radius:6px;background:rgba(200,168,75,0.15);display:flex;align-items:center;justify-content:center;font-size:14px">🎯</div>
            <div style="font-size:12px;font-weight:600;color:var(--gold);text-transform:uppercase;letter-spacing:1px">Principe #2 — La psychologie du jeu</div>
          </div>
          <blockquote style="margin:0;font-size:14px;color:var(--text);font-style:italic;line-height:1.7;border-left:3px solid var(--gold);padding-left:14px">"White induces its opponent to push him nearer to the center!"</blockquote>
          <p style="font-size:12px;color:var(--muted);margin-top:10px;line-height:1.6">💡 La manipulation tactique : forcer l'adversaire à vous pousser... vers où vous voulez aller. Un joueur avancé transforme les poussées adverses en <strong style="color:var(--text)">avantages positionnels</strong>.</p>
        </div>

        <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:20px">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
            <div style="width:28px;height:28px;border-radius:6px;background:rgba(200,168,75,0.15);display:flex;align-items:center;justify-content:center;font-size:14px">⚔️</div>
            <div style="font-size:12px;font-weight:600;color:var(--gold);text-transform:uppercase;letter-spacing:1px">Principe #3 — Le sacrifice productif</div>
          </div>
          <blockquote style="margin:0;font-size:14px;color:var(--text);font-style:italic;line-height:1.7;border-left:3px solid var(--gold);padding-left:14px">"With this fine sacrificial move it ensures its command of the center."</blockquote>
          <p style="font-size:12px;color:var(--muted);margin-top:10px;line-height:1.6">💡 Sacrifier une bille pour obtenir le centre est souvent un <strong style="color:var(--text)">excellent investissement</strong>. Le centre vaut plus qu'une bille matérielle en début et milieu de partie.</p>
        </div>

        <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:20px">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
            <div style="width:28px;height:28px;border-radius:6px;background:rgba(200,168,75,0.15);display:flex;align-items:center;justify-content:center;font-size:14px">⚡</div>
            <div style="font-size:12px;font-weight:600;color:var(--gold);text-transform:uppercase;letter-spacing:1px">Principe #4 — La division</div>
          </div>
          <blockquote style="margin:0;font-size:14px;color:var(--text);font-style:italic;line-height:1.7;border-left:3px solid var(--gold);padding-left:14px">"White managed to combine his balls and black is cut in two groups. Two balls are not enough compensation — white's position is already winning."</blockquote>
          <p style="font-size:12px;color:var(--muted);margin-top:10px;line-height:1.6">💡 <strong style="color:var(--text)">Diviser le groupe adverse</strong> est souvent plus efficace que d'éjecter des billes. Un adversaire en deux groupes ne peut défendre qu'un front à la fois.</p>
        </div>

        <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:20px">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
            <div style="width:28px;height:28px;border-radius:6px;background:rgba(200,168,75,0.15);display:flex;align-items:center;justify-content:center;font-size:14px">🏁</div>
            <div style="font-size:12px;font-weight:600;color:var(--gold);text-transform:uppercase;letter-spacing:1px">Principe #5 — La fin de partie</div>
          </div>
          <blockquote style="margin:0;font-size:14px;color:var(--text);font-style:italic;line-height:1.7;border-left:3px solid var(--gold);padding-left:14px">"With the next few moves white destroys the last bit of cohesion within the black balls before starting to push them out."</blockquote>
          <p style="font-size:12px;color:var(--muted);margin-top:10px;line-height:1.6">💡 En position gagnante, ne pas se précipiter. Détruire d'abord la <strong style="color:var(--text)">cohésion résiduelle</strong> adverse avant d'éjecter garantit que l'adversaire ne peut pas se reformer.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- PAGE: PUZZLES (INTERACTIVE) -->
<div class="page" id="page-analysis">
  <div style="padding-top:64px">
    <div class="page-header" style="padding:40px 60px 0">
      <div class="section-label">Outil d'analyse</div>
      <h2>Analyse de partie</h2>
      <p style="color:var(--muted);font-size:14px;max-width:640px">Rejoue une partie coup par coup, explore des variantes en jouant librement, et consulte l'évaluation de la position à chaque instant.</p>
    </div>
    <div style="display:flex;gap:32px;padding:24px 60px 80px;flex-wrap:wrap;align-items:flex-start">
      <!-- Plateau d'analyse -->
      <div style="flex-shrink:0">
        <canvas id="analysis-board" width="540" height="540" style="border-radius:12px;box-shadow:0 0 0 1px var(--border),0 12px 40px rgba(0,0,0,0.4);cursor:pointer;max-width:100%"></canvas>
        <!-- Barre d'évaluation -->
        <div style="margin-top:14px;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:14px 16px">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
            <span style="font-size:12px;letter-spacing:1px;text-transform:uppercase;color:var(--muted)">Évaluation</span>
            <span id="analysis-eval-text" style="font-size:13px;font-weight:700;color:var(--gold)">Équilibré</span>
          </div>
          <div style="height:10px;border-radius:5px;background:linear-gradient(90deg,#1a1a1a,#3a3a3a);overflow:hidden;position:relative">
            <div id="analysis-eval-bar" style="position:absolute;left:50%;top:0;bottom:0;width:2px;background:var(--gold);transition:all 0.3s"></div>
          </div>
          <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--muted);margin-top:4px">
            <span>⚫ Noirs</span><span>⚪ Blancs</span>
          </div>
          <!-- Courbe d'evaluation coup par coup : une chute verticale marque
               une erreur. Cliquable pour sauter directement a ce coup. -->
          <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--border)">
            <div style="font-size:12px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);margin-bottom:8px">Courbe de la partie</div>
            <div id="analysis-eval-curve"></div>
          </div>
          <div id="analysis-score" style="text-align:center;margin-top:12px;padding-top:12px;border-top:1px solid var(--border);font-size:13px;font-family:'DM Mono',monospace">
            <span style="color:var(--text)">Joueur 1 : 0</span><span style="color:var(--muted);margin:0 8px">—</span><span style="color:var(--text)">0 : Joueur 2</span><span style="color:var(--muted);margin-left:10px;font-size:11px">billes éjectées</span>
          </div>
        </div>
      </div>
      <!-- Panneau de contrôle -->
      <div style="flex:1;min-width:300px;max-width:400px;display:flex;flex-direction:column;gap:16px">
        <!-- Navigation -->
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px">
          <div style="font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);margin-bottom:12px">Navigation</div>
          <div style="display:flex;gap:8px;justify-content:center">
            <button onclick="analysisGoto(0)" style="flex:1;padding:10px;background:transparent;border:1px solid var(--border);border-radius:7px;cursor:pointer;color:var(--text);font-size:16px" title="Début">⏮</button>
            <button onclick="analysisStep(-1)" style="flex:1;padding:10px;background:transparent;border:1px solid var(--border);border-radius:7px;cursor:pointer;color:var(--text);font-size:16px" title="Précédent">◀</button>
            <button onclick="analysisStep(1)" style="flex:1;padding:10px;background:transparent;border:1px solid var(--border);border-radius:7px;cursor:pointer;color:var(--text);font-size:16px" title="Suivant">▶</button>
            <button onclick="analysisGoto(-1)" style="flex:1;padding:10px;background:transparent;border:1px solid var(--border);border-radius:7px;cursor:pointer;color:var(--text);font-size:16px" title="Fin">⏭</button>
          </div>
          <div id="analysis-position-info" style="text-align:center;font-size:12px;color:var(--muted);margin-top:10px">Aucune partie chargée</div>
          <button onclick="analysisShowBestMove()" id="analysis-bestmove-btn" style="width:100%;margin-top:12px;padding:11px;background:rgba(200,168,75,0.12);border:1px solid var(--gold-dim);border-radius:8px;cursor:pointer;color:var(--gold);font-size:13px;font-weight:600;font-family:'DM Sans',sans-serif">💡 Suggérer le meilleur coup</button>
          <div id="analysis-bestmove-info" style="text-align:center;font-size:12px;color:var(--gold);margin-top:8px;min-height:18px"></div>
        </div>
        <!-- Moteur de compréhension : les 7 étages construits dans cette session -->
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px">
          <div style="font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);margin-bottom:12px">🧠 Comprendre la position</div>
          <div style="display:flex;gap:8px;margin-bottom:10px">
            <button id="comprehension-color-black" onclick="setComprehensionColor('black',this)" class="active" style="flex:1;padding:8px;background:rgba(200,168,75,0.12);border:1px solid var(--gold-dim);border-radius:7px;cursor:pointer;color:var(--text);font-size:12px">Joueur 1</button>
            <button id="comprehension-color-white" onclick="setComprehensionColor('white',this)" style="flex:1;padding:8px;background:transparent;border:1px solid var(--border);border-radius:7px;cursor:pointer;color:var(--text);font-size:12px">Joueur 2</button>
          </div>
          <button onclick="renderComprehensionPanel()" style="width:100%;padding:11px;background:rgba(200,168,75,0.12);border:1px solid var(--gold-dim);border-radius:8px;cursor:pointer;color:var(--gold);font-size:13px;font-weight:600;font-family:'DM Sans',sans-serif">🧠 Analyser cette position</button>
          <div id="comprehension-result" style="margin-top:10px;min-height:18px"></div>
          <button class="tech-toggle-btn btn" style="margin-top:8px;font-size:11px;padding:5px 10px" onclick="toggleTechMode()">🔬 Voir le détail technique</button>
          <div style="border-top:1px solid var(--border);margin-top:12px;padding-top:12px">
            <button onclick="chercherMenaceTactique()" style="width:100%;padding:10px;background:transparent;border:1px solid var(--border);border-radius:8px;cursor:pointer;color:var(--text);font-size:12px">🔍 Chercher une menace tactique (recherche à la demande)</button>
            <div id="comprehension-menace-n" style="text-align:center;font-size:12px;color:var(--muted);margin-top:8px;min-height:16px"></div>
          </div>
          <div style="border-top:1px solid var(--border);margin-top:12px;padding-top:12px;display:flex;gap:8px">
            <button onclick="capturerReference()" style="flex:1;padding:9px;background:transparent;border:1px solid var(--border);border-radius:8px;cursor:pointer;color:var(--text);font-size:11px">📌 Capturer comme référence</button>
            <button onclick="effacerReference()" style="padding:9px 12px;background:transparent;border:1px solid var(--border);border-radius:8px;cursor:pointer;color:var(--muted);font-size:11px">🗑</button>
          </div>
        </div>
        <!-- Liste des coups -->
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px">
          <div style="font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);margin-bottom:12px">Historique des coups</div>
          <div id="analysis-moves" style="max-height:200px;overflow-y:auto;font-size:13px;color:var(--text);font-family:'DM Mono',monospace;line-height:1.8">
            <div style="color:var(--muted);font-style:italic">Charge une partie pour voir les coups</div>
          </div>
        </div>
        <!-- Sources -->
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px">
          <div style="font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);margin-bottom:12px">Charger</div>
          <div style="display:flex;flex-direction:column;gap:8px">
            <button onclick="analysisLoadLastGame()" style="padding:10px;background:transparent;border:1px solid var(--border);border-radius:7px;cursor:pointer;color:var(--text);font-size:13px;font-family:'DM Sans',sans-serif;text-align:left">🎮 Ma dernière partie</button>
            <button onclick="analysisFromEditor()" style="padding:10px;background:transparent;border:1px solid var(--border);border-radius:7px;cursor:pointer;color:var(--text);font-size:13px;font-family:'DM Sans',sans-serif;text-align:left">✏️ Position de l'éditeur</button>
            <button onclick="analysisFromStandard()" style="padding:10px;background:transparent;border:1px solid var(--border);border-radius:7px;cursor:pointer;color:var(--text);font-size:13px;font-family:'DM Sans',sans-serif;text-align:left">🔄 Position standard</button>
          </div>
          <div style="font-size:11px;color:var(--muted);margin-top:12px;padding-top:12px;border-top:1px solid var(--border)">💡 Sur le plateau, clique tes billes pour jouer librement et explorer des variantes.</div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="page" id="page-editor">
  <div style="padding-top:64px">
    <div class="page-header" style="padding:40px 60px 0">
      <div class="section-label">Outil de création</div>
      <h2>Éditeur de position</h2>
      <p style="color:var(--muted);font-size:14px;max-width:600px">Place librement les billes sur le plateau pour créer une position de départ, un puzzle ou une variante. Choisis un outil dans la palette, puis clique sur les cases.</p>
    </div>
    <div style="display:flex;gap:32px;padding:24px 60px 80px;flex-wrap:wrap;align-items:flex-start">
      <!-- Plateau -->
      <div style="flex-shrink:0">
        <canvas id="editor-board" width="500" height="500" style="border-radius:12px;box-shadow:0 0 0 1px var(--border),0 12px 40px rgba(0,0,0,0.4);cursor:pointer;max-width:100%"></canvas>
        <div id="editor-status" style="text-align:center;font-size:13px;color:var(--muted);margin-top:10px">0 billes Joueur 1 · 0 billes Joueur 2</div>
      </div>
      <!-- Panneau de contrôle -->
      <div style="flex:1;min-width:280px;max-width:380px">
        <!-- Palette -->
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px;margin-bottom:16px">
          <div style="font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);margin-bottom:12px">Outil de placement</div>
          <div style="display:flex;gap:8px">
            <button id="edtool-black" onclick="setEditorTool('black',this)" class="editor-tool-btn" style="flex:1;padding:14px 8px;border-radius:8px;border:2px solid var(--gold);background:rgba(200,168,75,0.08);cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:6px">
              <span style="width:26px;height:26px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#4a4a4a,#0d0d0d);display:inline-block"></span>
              <span style="font-size:11px;color:var(--text);font-weight:600">Joueur 1</span>
            </button>
            <button id="edtool-white" onclick="setEditorTool('white',this)" class="editor-tool-btn" style="flex:1;padding:14px 8px;border-radius:8px;border:2px solid var(--border);background:transparent;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:6px">
              <span style="width:26px;height:26px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#fff,#b8b0a0);display:inline-block"></span>
              <span style="font-size:11px;color:var(--text);font-weight:600">Joueur 2</span>
            </button>
            <button id="edtool-erase" onclick="setEditorTool('erase',this)" class="editor-tool-btn" style="flex:1;padding:14px 8px;border-radius:8px;border:2px solid var(--border);background:transparent;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:6px">
              <span style="font-size:24px;line-height:26px">🧽</span>
              <span style="font-size:11px;color:var(--text);font-weight:600">Gomme</span>
            </button>
          </div>
          <div style="font-size:11px;color:var(--muted);margin-top:10px;text-align:center">Astuce : reclique une bille pour l'effacer</div>
        </div>

        <!-- Billes déjà éjectées -->
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px;margin-bottom:16px">
          <div style="font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);margin-bottom:4px">Billes déjà éjectées</div>
          <div style="font-size:11px;color:var(--muted);margin-bottom:12px">Pour construire une position de fin de partie (ex : puzzle où un camp est proche de la défaite).</div>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
            <span style="font-size:12px;color:var(--text)">Joueur 1</span>
            <div style="display:flex;align-items:center;gap:8px">
              <button onclick="editorAdjustCaptured('black',-1)" style="width:26px;height:26px;border-radius:6px;border:1px solid var(--border);background:transparent;color:var(--text);cursor:pointer">−</button>
              <span id="editor-captured-black" style="min-width:16px;text-align:center;font-weight:700;color:var(--gold)">0</span>
              <button onclick="editorAdjustCaptured('black',1)" style="width:26px;height:26px;border-radius:6px;border:1px solid var(--border);background:transparent;color:var(--text);cursor:pointer">+</button>
            </div>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between">
            <span style="font-size:12px;color:var(--text)">Joueur 2</span>
            <div style="display:flex;align-items:center;gap:8px">
              <button onclick="editorAdjustCaptured('white',-1)" style="width:26px;height:26px;border-radius:6px;border:1px solid var(--border);background:transparent;color:var(--text);cursor:pointer">−</button>
              <span id="editor-captured-white" style="min-width:16px;text-align:center;font-weight:700;color:var(--gold)">0</span>
              <button onclick="editorAdjustCaptured('white',1)" style="width:26px;height:26px;border-radius:6px;border:1px solid var(--border);background:transparent;color:var(--text);cursor:pointer">+</button>
            </div>
          </div>
        </div>

        <!-- Positions prédéfinies -->
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px;margin-bottom:16px">
          <div style="font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);margin-bottom:12px">Charger une position</div>
          <div style="display:flex;flex-direction:column;gap:8px">
            <button onclick="loadEditorPreset('standard')" class="editor-preset-btn">⬢ Position standard</button>
            <button onclick="loadEditorPreset('belgian')" class="editor-preset-btn">🌼 Belgian Daisy</button>
            <button onclick="loadEditorPreset('german')" class="editor-preset-btn">🌻 German Daisy</button>
            <button onclick="loadEditorPreset('empty')" class="editor-preset-btn">⬜ Plateau vide</button>
          </div>
        </div>

        <!-- Actions -->
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px">
          <div style="font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);margin-bottom:12px">Utiliser cette position</div>
          <div style="display:flex;flex-direction:column;gap:8px">
            <button onclick="playFromEditor()" style="padding:12px;background:var(--gold);border:none;border-radius:8px;color:#0d0f0e;font-weight:700;font-size:13px;cursor:pointer;font-family:'DM Sans',sans-serif">▶ Jouer cette position</button>
            <button onclick="testAsPuzzle()" style="padding:12px;background:transparent;border:1px solid var(--gold-dim);border-radius:8px;color:var(--gold);font-weight:600;font-size:13px;cursor:pointer;font-family:'DM Sans',sans-serif">🧩 Tester comme puzzle</button>
            <button onclick="exportEditorPosition()" style="padding:12px;background:transparent;border:1px solid var(--border);border-radius:8px;color:var(--text);font-weight:600;font-size:13px;cursor:pointer;font-family:'DM Sans',sans-serif">📋 Copier le code de position</button>
            <button onclick="shareEditorPositionURL()" style="padding:12px;background:transparent;border:1px solid var(--border);border-radius:8px;color:var(--text);font-weight:600;font-size:13px;cursor:pointer;font-family:'DM Sans',sans-serif">🔗 Partager par lien (Discord)</button>
            <button onclick="loadEditorPreset('empty')" style="padding:10px;background:transparent;border:1px solid var(--border);border-radius:8px;color:var(--muted);font-size:12px;cursor:pointer;font-family:'DM Sans',sans-serif">↺ Tout effacer</button>
          </div>
          <div style="font-size:11px;color:var(--muted);margin-top:10px;font-style:italic">Coordonnées affichées en notation officielle (A-I / 1-9)</div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="page" id="page-puzzles">
  <div style="display:grid;grid-template-columns:1fr 340px;min-height:calc(100vh - 64px);padding-top:64px">
    <div style="padding:40px 40px 40px 60px">
      <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--gold)">Abalone Academy</div>
      <h2 style="margin-bottom:8px">Problèmes tactiques</h2>

      <!-- BARRE DE PROGRESSION (Entraînement) -->
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;gap:12px">
        <div style="flex:1;height:8px;background:var(--surface2);border-radius:4px;overflow:hidden">
          <div id="puzzle-progress-bar" style="height:100%;width:0%;background:var(--gold);border-radius:4px;transition:width 0.3s"></div>
        </div>
        <div id="puzzle-progress-label" style="font-size:12px;color:var(--muted);white-space:nowrap;font-weight:600">0 / 0 résolus</div>
      </div>

      <!-- PUZZLE DU JOUR -->
      <div style="background:var(--surface);border:1px solid var(--gold-dim);border-radius:14px;padding:18px 20px;margin-bottom:16px">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px">
          <span style="font-size:13px;font-weight:700;color:var(--white);text-transform:uppercase;letter-spacing:1px">Le puzzle du jour</span>
        </div>
        <div id="daily-puzzle-card"></div>
      </div>

      <!-- PROBLÈME DU MOIS -->
      <div style="background:var(--surface);border:1px solid var(--gold-dim);border-radius:14px;padding:18px 20px;margin-bottom:24px">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px">
          <span style="font-size:20px">🏆</span>
          <span style="font-size:13px;font-weight:700;color:var(--white);text-transform:uppercase;letter-spacing:1px">Le problème du mois</span>
        </div>
        <div id="monthly-puzzle-card"></div>
      </div>

      <!-- REVISION (repetition espacee) -- puzzles deja tentes, a revoir
           maintenant selon leur planning. Mode separe du puzzle du jour/du
           mois (deterministes par date, jamais touches). -->
      <div id="srs-review-card" style="background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:18px 20px;margin-bottom:24px;display:none">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
          <span style="font-size:20px">🔁</span>
          <span style="font-size:13px;font-weight:700;color:var(--white);text-transform:uppercase;letter-spacing:1px">À réviser</span>
        </div>
        <div id="srs-review-text" style="font-size:13px;color:var(--muted);margin-bottom:10px"></div>
        <button class="ctrl-btn" onclick="srsStartReview()" style="width:auto;padding:8px 16px">Réviser maintenant</button>
      </div>

      <!-- Mode selector -->
      <div style="display:flex;gap:10px;margin-bottom:24px;flex-wrap:wrap">
        <div class="puzzle-mode-btn active" id="puzzle-mode-normal" onclick="setPuzzleMode('normal',this)">
          <div style="font-size:18px;margin-bottom:3px">🧩</div>
          <div style="font-size:12px;font-weight:600;color:var(--white)">Entraînement</div>
          <div style="font-size:10px;color:var(--muted)">À votre rythme</div>
        </div>
        <div class="puzzle-mode-btn" id="puzzle-mode-storm" onclick="setPuzzleMode('storm',this)">
          <div style="font-size:18px;margin-bottom:3px">⚡</div>
          <div style="font-size:12px;font-weight:600;color:var(--white)">Puzzle Storm</div>
          <div style="font-size:10px;color:var(--muted)">3 min chrono</div>
        </div>
        <div class="puzzle-mode-btn" id="puzzle-mode-daily" onclick="setPuzzleMode('daily',this)">
          <div style="font-size:18px;margin-bottom:3px">🔥</div>
          <div style="font-size:12px;font-weight:600;color:var(--white)">Défi du jour</div>
          <div style="font-size:10px;color:var(--gold)">Nouveau chaque jour</div>
        </div>
        <div class="puzzle-mode-btn" id="puzzle-mode-generated" onclick="setPuzzleMode('generated',this)">
          <div style="font-size:18px;margin-bottom:3px">🎲</div>
          <div style="font-size:12px;font-weight:600;color:var(--white)">Puzzle infini</div>
          <div style="font-size:10px;color:var(--gold)">Généré par l'IA</div>
        </div>
        <div class="puzzle-mode-btn" id="puzzle-mode-tablebase" onclick="setPuzzleMode('tablebase',this)">
          <div style="font-size:18px;margin-bottom:3px">🧮</div>
          <div style="font-size:12px;font-weight:600;color:var(--white)">Finale prouvée</div>
          <div style="font-size:10px;color:var(--gold)">1 sur 12,96M</div>
        </div>
      </div>

      <!-- Storm UI -->
      <div id="storm-ui" style="display:none;background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:16px;margin-bottom:20px">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
          <div style="font-size:26px;font-weight:900;font-family:'DM Mono',monospace;color:var(--gold)" id="storm-timer">3:00</div>
          <div style="text-align:center"><div style="font-size:24px;font-weight:900;color:var(--white)" id="storm-score">0</div><div style="font-size:10px;color:var(--muted)">résolus</div></div>
          <div style="text-align:center"><div style="font-size:24px;font-weight:900;color:#e05c4b" id="storm-errors">0</div><div style="font-size:10px;color:var(--muted)">erreurs</div></div>
          <button onclick="startPuzzleStorm()" id="storm-btn" style="padding:9px 18px;background:var(--gold);border:none;border-radius:7px;color:#0d0f0e;font-size:13px;font-weight:700;cursor:pointer;font-family:'DM Sans',sans-serif">▶ Start</button>
        </div>
        <div style="height:4px;background:var(--border);border-radius:2px;overflow:hidden"><div id="storm-bar" style="height:100%;background:var(--gold);width:100%;transition:width 1s linear;border-radius:2px"></div></div>
      </div>

      <!-- Challenge card -->
      <div style="background:rgba(200,168,75,0.06);border:1px solid rgba(200,168,75,0.2);border-radius:10px;padding:18px 22px;margin-bottom:20px">
        <div style="font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);margin-bottom:6px" id="puzzle-difficulty-label">🟡 Difficulté Moyenne</div>
        <div style="font-size:15px;color:var(--text);line-height:1.7" id="puzzle-statement">Chargement du puzzle...</div>
      </div>

      <!-- Interactive board -->
      <div style="display:flex;align-items:center;justify-content:center;margin:20px 0;position:relative">
        <div style="position:relative">
          <canvas id="puzzle-board" width="400" height="400" style="border-radius:12px;box-shadow:0 0 0 1px var(--border),0 12px 40px rgba(0,0,0,0.4);cursor:pointer"></canvas>
          <div style="text-align:center;margin-top:10px;font-size:12px;color:var(--muted);font-family:'DM Mono',monospace" id="puzzle-msg">⚫ Sélectionnez une bille noire</div>
          <!-- Result overlay -->
          <div id="puzzle-result-overlay" style="display:none;position:absolute;inset:0;background:rgba(13,15,14,0.88);backdrop-filter:blur(6px);border-radius:12px;flex-direction:column;align-items:center;justify-content:center;gap:12px;text-align:center">
            <div style="font-size:44px" id="puzzle-result-icon">✅</div>
            <div style="font-family:'Playfair Display',serif;font-size:22px;font-weight:900;color:var(--gold)" id="puzzle-result-title">Bravo !</div>
            <div style="font-size:13px;color:var(--muted)" id="puzzle-result-sub">Puzzle résolu !</div>
            <button onclick="nextPuzzle()" style="padding:10px 24px;background:var(--gold);border:none;border-radius:8px;color:#0d0f0e;font-size:13px;font-weight:700;cursor:pointer;font-family:'DM Sans',sans-serif">Puzzle suivant →</button>
          </div>
        </div>
      </div>

      <!-- Controls -->
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px">
        <button onclick="togglePuzzleHint()" class="cam-btn outline" style="padding:10px 18px">💡 Indice</button>
        <button onclick="showPuzzleSolution()" class="cam-btn outline" style="padding:10px 18px">👁 Solution</button>
        <button onclick="resetCurrentPuzzle()" class="cam-btn outline" style="padding:10px 18px">🔄 Reset</button>
        <button onclick="togglePuzzleCoords()" class="cam-btn outline" style="padding:10px 18px" id="puzzle-coords-btn">🔤 Coordonnées</button>
        <button onclick="nextPuzzle()" class="cam-btn primary" style="padding:10px 18px">⟩ Suivant</button>
      </div>
      <div id="puzzle-hint" style="display:none;margin-top:12px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:14px 16px;font-size:13px;color:var(--text)"></div>
      <div id="puzzle-solution" style="display:none;margin-top:8px;background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:14px 16px">
        <div style="font-size:12px;font-weight:600;color:var(--gold);margin-bottom:6px">Solution :</div>
        <div id="puzzle-solution-text" style="font-size:13px;color:var(--text);font-family:'DM Mono',monospace;line-height:1.8"></div>
      </div>
    </div>

    <!-- Sidebar -->
    <div style="background:var(--surface);border-left:1px solid var(--border);padding:80px 24px 40px;display:flex;flex-direction:column;gap:12px;overflow-y:auto">
      <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--muted)">Série de problèmes</div>
      <div id="puzzle-list" style="display:flex;flex-direction:column;gap:6px"></div>
      <div style="margin-top:auto;padding:12px;background:rgba(200,168,75,0.05);border:1px solid rgba(200,168,75,0.15);border-radius:8px;font-size:11px;color:var(--muted);line-height:1.7">
        📚 <a href="https://onlineabalone.wordpress.com/abalone-academy/problemes-abaloniens/" target="_blank" rel="noopener noreferrer" style="color:var(--gold)">onlineabalone.wordpress.com</a>
      </div>
    </div>
  </div>
</div>

<!-- PAGE: VARIANTS -->
<div class="page" id="page-variants">
  <div class="page-header">
    <div class="section-label">Inspiré de <a href="https://onlineabalone.wordpress.com/les-variantes/" target="_blank" rel="noopener noreferrer" style="color:var(--gold);text-decoration:none">onlineabalone.wordpress.com</a></div>
    <h2>Les Variantes</h2>
    <p style="color:var(--muted);font-size:15px;margin-top:12px;max-width:560px">Du classique 2J aux modes multi-joueurs et variantes expérimentales.</p>
  </div>
  <div style="padding:0 60px 80px">
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:32px" id="variants-grid"></div>
    <!-- Positions catalog from onlineabalone.wordpress.com -->
    <div style="margin-top:32px">
      <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:16px">Positions de départ — Source : <a href="https://onlineabalone.wordpress.com" target="_blank" rel="noopener noreferrer" style="color:var(--gold)">onlineabalone.wordpress.com</a></div>
      <div style="font-family:'Playfair Display',serif;font-size:20px;font-weight:900;color:var(--white);margin-bottom:6px">9 catégories de positions</div>
      <p style="color:var(--muted);font-size:13px;line-height:1.7;margin-bottom:20px">Catalogue complet des configurations de départ classées par type tactique.</p>

      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px">
<div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:16px;cursor:pointer;transition:all 0.15s" onmouseover="this.style.borderColor='var(--gold-dim)'" onmouseout="this.style.borderColor='var(--border)'"><div style="font-size:22px;margin-bottom:8px">🛡</div><div style="font-size:13px;font-weight:700;color:var(--white);margin-bottom:4px">1. Bloc défensif</div><div style="font-size:11px;color:var(--muted);line-height:1.5">Groupes compacts face à face — défense prioritaire</div></div><div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:16px;cursor:pointer;transition:all 0.15s" onmouseover="this.style.borderColor='var(--gold-dim)'" onmouseout="this.style.borderColor='var(--border)'"><div style="font-size:22px;margin-bottom:8px">🔒</div><div style="font-size:13px;font-weight:700;color:var(--white);margin-bottom:4px">2. Bloc emprisonnant</div><div style="font-size:11px;color:var(--muted);line-height:1.5">Encerclement de l'adversaire par blocs serrés</div></div><div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:16px;cursor:pointer;transition:all 0.15s" onmouseover="this.style.borderColor='var(--gold-dim)'" onmouseout="this.style.borderColor='var(--border)'"><div style="font-size:22px;margin-bottom:8px">🌊</div><div style="font-size:13px;font-weight:700;color:var(--white);margin-bottom:4px">3. Espace défensif</div><div style="font-size:11px;color:var(--muted);line-height:1.5">Groupes distants avec liberté de manœuvre</div></div><div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:16px;cursor:pointer;transition:all 0.15s" onmouseover="this.style.borderColor='var(--gold-dim)'" onmouseout="this.style.borderColor='var(--border)'"><div style="font-size:22px;margin-bottom:8px">🕸</div><div style="font-size:13px;font-weight:700;color:var(--white);margin-bottom:4px">4. Espace emprisonnant</div><div style="font-size:11px;color:var(--muted);line-height:1.5">Contrôle de l'espace pour limiter l'adversaire</div></div><div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:16px;cursor:pointer;transition:all 0.15s" onmouseover="this.style.borderColor='var(--gold-dim)'" onmouseout="this.style.borderColor='var(--border)'"><div style="font-size:22px;margin-bottom:8px">⚔️</div><div style="font-size:13px;font-weight:700;color:var(--white);margin-bottom:4px">5. Sous-groupes offensifs</div><div style="font-size:11px;color:var(--muted);line-height:1.5">Attaque sur plusieurs fronts simultanés</div></div><div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:16px;cursor:pointer;transition:all 0.15s" onmouseover="this.style.borderColor='var(--gold-dim)'" onmouseout="this.style.borderColor='var(--border)'"><div style="font-size:22px;margin-bottom:8px">🎯</div><div style="font-size:13px;font-weight:700;color:var(--white);margin-bottom:4px">6. Sous-groupes emprisonnant</div><div style="font-size:11px;color:var(--muted);line-height:1.5">Encerclement par petits groupes coordonnés</div></div><div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:16px;cursor:pointer;transition:all 0.15s" onmouseover="this.style.borderColor='var(--gold-dim)'" onmouseout="this.style.borderColor='var(--border)'"><div style="font-size:22px;margin-bottom:8px">✕</div><div style="font-size:13px;font-weight:700;color:var(--white);margin-bottom:4px">7. Entrecroisées</div><div style="font-size:11px;color:var(--muted);line-height:1.5">Positions en croix — tensions sur tous les axes</div></div><div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:16px;cursor:pointer;transition:all 0.15s" onmouseover="this.style.borderColor='var(--gold-dim)'" onmouseout="this.style.borderColor='var(--border)'"><div style="font-size:22px;margin-bottom:8px">💥</div><div style="font-size:13px;font-weight:700;color:var(--white);margin-bottom:4px">8. Éclatées</div><div style="font-size:11px;color:var(--muted);line-height:1.5">Billes dispersées — regroupement nécessaire</div></div><div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:16px;cursor:pointer;transition:all 0.15s" onmouseover="this.style.borderColor='var(--gold-dim)'" onmouseout="this.style.borderColor='var(--border)'"><div style="font-size:22px;margin-bottom:8px">⚖️</div><div style="font-size:13px;font-weight:700;color:var(--white);margin-bottom:4px">9. Variantes déséquilibrées</div><div style="font-size:11px;color:var(--muted);line-height:1.5">Asymétrie délibérée — tactiques différentes</div></div>
      </div>
    </div>

    <div style="display:none;background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:24px;margin-top:20px" id="variant-detail">
      <div id="variant-detail-content"></div>
    </div>
  </div>
</div>

<!-- PAGE: COMMUNITY -->
<div class="page" id="page-community">
  <div class="page-header">
    <div class="section-label">Rejoindre la communauté</div>
    <h2>Joueurs & Communauté</h2>
  </div>
  <div style="padding:0 60px 80px">

    <!-- ═══ CHAT GÉNÉRAL (maquette — branché sur le backend à venir) ═══ -->
    <div style="margin-top:32px;background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden">
      <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid var(--border);background:rgba(200,168,75,0.04)">
        <div style="display:flex;align-items:center;gap:10px">
          <span style="font-size:20px">🌍</span>
          <div>
            <div style="font-size:15px;font-weight:700;color:var(--white)">Chat général</div>
            <div style="font-size:11px;color:var(--muted)"><span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--muted);margin-right:5px"></span>Mode hors-ligne — chat multijoueur à venir (nécessite un backend, non déployé)</div>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:8px">
          <span style="font-size:11px;color:var(--muted)">🌐 Traduction auto</span>
          <label style="position:relative;display:inline-block;width:42px;height:24px;flex-shrink:0">
            <input type="checkbox" id="gchat-translate" checked style="opacity:0;width:0;height:0" onchange="this.nextElementSibling.style.background=this.checked?'var(--gold)':'var(--border)';showToast(this.checked?'🌐 Traduction automatique activée':'Traduction désactivée')">
            <span style="position:absolute;inset:0;background:var(--gold);border-radius:12px;cursor:pointer;transition:0.2s"></span>
          </label>
        </div>
      </div>
      <div id="gchat-messages" style="height:280px;overflow-y:auto;padding:16px 20px;display:flex;flex-direction:column;gap:12px">
        <div class="gchat-msg"><div style="display:flex;align-items:baseline;gap:8px"><span style="font-weight:700;color:#7eccd8;font-size:13px">Vincent_F</span><span style="font-size:10px;color:var(--muted)">🇫🇷 FR</span><span style="font-size:10px;color:var(--muted)">14:32</span></div><div style="font-size:13px;color:var(--text);margin-top:2px">Quelqu'un pour une partie classée ce soir ?</div></div>
        <div class="gchat-msg"><div style="display:flex;align-items:baseline;gap:8px"><span style="font-weight:700;color:#e0a85c;font-size:13px">KosmicKnight</span><span style="font-size:10px;color:var(--muted)">🇬🇧 EN</span><span style="font-size:10px;color:var(--muted)">14:33</span></div><div style="font-size:13px;color:var(--text);margin-top:2px">Je suis partant ! <span style="font-size:11px;color:var(--gold);font-style:italic">(traduit de l'anglais : "I'm in!")</span></div></div>
        <div class="gchat-msg"><div style="display:flex;align-items:baseline;gap:8px"><span style="font-weight:700;color:#b89ef0;font-size:13px">SaaBalone</span><span style="font-size:10px;color:var(--muted)">🇪🇸 ES</span><span style="font-size:10px;color:var(--muted)">14:35</span></div><div style="font-size:13px;color:var(--text);margin-top:2px">Belle partie hier soir, GG ! <span style="font-size:11px;color:var(--gold);font-style:italic">(traduit de l'espagnol)</span></div></div>
        <div class="gchat-msg"><div style="display:flex;align-items:baseline;gap:8px"><span style="font-weight:700;color:#7eccd8;font-size:13px">AbaloneMaster</span><span style="font-size:10px;color:var(--muted)">🇩🇪 DE</span><span style="font-size:10px;color:var(--muted)">14:38</span></div><div style="font-size:13px;color:var(--text);margin-top:2px">Quelqu'un a vu le dernier tournoi MSO ? <span style="font-size:11px;color:var(--gold);font-style:italic">(traduit de l'allemand)</span></div></div>
      </div>
      <div style="padding:12px 20px;border-top:1px solid var(--border)">
        <div style="display:flex;gap:8px">
          <input id="gchat-input" class="form-input" placeholder="Écrire au chat général…" style="flex:1;padding:10px 14px;font-size:13px" onkeydown="if(event.key==='Enter')sendGeneralChat()">
          <button onclick="sendGeneralChat()" style="padding:10px 18px;background:var(--gold);border:none;border-radius:7px;cursor:pointer;font-size:15px;color:#0d0f0e">➤</button>
        </div>
        <div style="font-size:10px;color:var(--muted);margin-top:8px;text-align:center;font-style:italic">💡 Aperçu de l'interface — le chat en temps réel et la traduction automatique seront actifs avec la mise en ligne multijoueur</div>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:32px">
      <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:24px">
