    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-formateurs" onclick="sidebarNav('formateurs',this)">
      <span class="s-icon">🧑‍🏫</span><span class="s-label">Formation Formateurs</span>
    </button>

    <div class="sidebar-group-label">🧪 Explorer</div>
    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-lab" onclick="openLabFromMenu(this)">
      <span class="s-icon">🧪</span><span class="s-label">Labo IA</span>
