<!-- ══════════════════════════════════════════
     PAGE: STATISTIQUES (chess.com style)
══════════════════════════════════════════ -->
<div class="page" id="page-stats">
  <div class="page-header" style="padding-bottom:32px">
    <div class="section-label">Votre progression</div>
    <h2>Statistiques</h2>
    <button class="tech-toggle-btn btn" style="margin-top:10px;font-size:12px;padding:6px 12px" onclick="toggleTechMode()">🔬 Voir le détail technique</button>
    <div class="tech-detail" style="display:none;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px 20px;margin-top:14px;max-width:680px">
      <strong style="color:var(--gold);font-size:13px">Comment le "Top %" est calculé</strong>
      <p style="margin:8px 0 0;font-size:13px;color:var(--muted);line-height:1.7">Interpolation linéaire entre points de référence d'une distribution cumulative (CDF) : la valeur exacte entre deux points connus est estimée proportionnellement, pas juste arrondie au point le plus proche. L'arrondi n'intervient qu'à l'affichage — le calcul lui-même reste exact.</p>
    </div>
  </div>
  <div style="padding:0 60px 80px;max-width:800px">

    <!-- Period tabs -->
    <div class="stats-period-tabs" id="stats-period">
      <button class="period-tab" onclick="setStatsPeriod(7,this)">7 jours</button>
      <button class="period-tab" onclick="setStatsPeriod(30,this)">30 jours</button>
      <button class="period-tab" onclick="setStatsPeriod(90,this)">90 jours</button>
      <button class="period-tab" onclick="setStatsPeriod(365,this)">1 an</button>
      <button class="period-tab active" onclick="setStatsPeriod(0,this)">Tout</button>
    </div>

    <!-- Player summary -->
    <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px">
      <div id="stats-avatar" style="width:56px;height:56px;border-radius:50%;background:#2d5a3d;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:900;font-family:'Playfair Display',serif;color:var(--gold)">?</div>
      <div>
        <div style="font-size:18px;font-weight:700;color:var(--white)" id="stats-name">—</div>
        <div style="font-size:13px;color:var(--muted)" id="stats-handle">@—</div>
      </div>
      <button onclick="showPage('compare')" style="margin-left:auto;padding:8px 16px;background:none;border:1px solid var(--border);color:var(--text);border-radius:8px;cursor:pointer;font-size:13px;font-family:'DM Sans',sans-serif;display:flex;align-items:center;gap:6px">⚖️ Comparer</button>
    </div>

    <!-- ELO chart -->
    <div class="elo-chart-wrap">
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px">
        <div>
          <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px">ELO Actuel</div>
          <div style="font-family:'Playfair Display',serif;font-size:32px;font-weight:900;color:var(--gold)" id="stats-elo">—</div>
        </div>
        <div style="text-align:right">
          <div style="font-size:14px;color:var(--accent-green-light);font-weight:600" id="stats-elo-delta">—</div>
          <div style="font-size:11px;color:var(--muted)">vs période précédente</div>
        </div>
      </div>
      <div id="stats-elo-chart-host"></div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:12px;border-top:1px solid var(--border);padding-top:12px">
        <div style="text-align:center" title="Nécessite un compte en ligne — le backend n'est pas activé sur ce site">
          <div style="font-size:11px;color:var(--muted)">Classement global</div>
          <div style="font-family:'DM Mono',monospace;font-size:14px;color:var(--text);margin-top:3px" id="stats-rank-global">—</div>
        </div>
        <div style="text-align:center;border-left:1px solid var(--border);border-right:1px solid var(--border)" title="Nécessite un compte en ligne — le backend n'est pas activé sur ce site">
          <div style="font-size:11px;color:var(--muted)">Rang amis</div>
          <div style="font-family:'DM Mono',monospace;font-size:14px;color:var(--gold);margin-top:3px" id="stats-rank-friends">—</div>
        </div>
        <div style="text-align:center" title="Nécessite un compte en ligne — le backend n'est pas activé sur ce site">
          <div style="font-size:11px;color:var(--muted)">Top %</div>
          <div style="font-family:'DM Mono',monospace;font-size:14px;color:var(--accent-green-light);margin-top:3px" id="stats-top-pct">—</div>
        </div>
      </div>
    </div>

    <!-- Stats grid -->
    <div class="stats-grid" id="stats-grid">
      <div class="stat-card"><div class="stat-card-icon">🎮</div><div class="stat-card-val" id="sg-games">0</div><div class="stat-card-label">Parties</div></div>
      <div class="stat-card"><div class="stat-card-icon">🧩</div><div class="stat-card-val" id="sg-puzzles">0</div><div class="stat-card-label">Puzzles</div></div>
      <div class="stat-card"><div class="stat-card-icon">🏆</div><div class="stat-card-val" id="sg-wins">0</div><div class="stat-card-label">Victoires</div><div class="stat-card-delta up" id="stat-winrate">—</div></div>
      <div class="stat-card"><div class="stat-card-icon">🔥</div><div class="stat-card-val" id="sg-streak">0</div><div class="stat-card-label">Série active</div><div class="stat-card-delta up" id="stat-streak-record">—</div></div>
      <div class="stat-card"><div class="stat-card-icon">⏱</div><div class="stat-card-val">—</div><div class="stat-card-label">Temps de jeu</div><div class="stat-card-delta" style="color:var(--muted)" title="Pas encore suivi par le site">non suivi</div></div>
      <div class="stat-card"><div class="stat-card-icon">⚡</div><div class="stat-card-val" id="sg-xp">0</div><div class="stat-card-label">XP Total</div><div class="stat-card-delta up" id="stat-xp-delta">—</div></div>
      <div class="stat-card" title="Écart moyen entre tes coups joués et le meilleur coup selon le moteur, sur tes parties analysées"><div class="stat-card-icon">🎯</div><div class="stat-card-val" id="sg-had">—</div><div class="stat-card-label">Divergence IA (HAD)</div><div class="stat-card-delta" style="color:var(--muted)" id="stat-had-detail">—</div></div>
    </div>

    <!-- ELO max record -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:8px">
      <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:16px;text-align:center">
        <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:4px">ELO Max</div>
        <div style="font-family:'DM Mono',monospace;font-size:22px;font-weight:700;color:var(--gold)" id="stats-elo-max">—</div>
        <div style="font-size:11px;color:var(--muted);margin-top:3px" id="stats-elo-max-date">—</div>
      </div>
      <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:16px;text-align:center" title="Pas encore suivi par le site">
        <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:4px">Temps compétitif</div>
        <div style="font-family:'DM Mono',monospace;font-size:22px;font-weight:700;color:var(--text)">—</div>
        <div style="font-size:11px;color:var(--muted);margin-top:3px">non suivi</div>
      </div>
    </div>

    <!-- Statistiques par moteur -- general (benchmark connu) + personnel
         (calcule depuis l'historique de parties). -->
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px 20px;margin-top:24px">
      <div style="font-size:13px;font-weight:700;color:var(--white);text-transform:uppercase;letter-spacing:1px;margin-bottom:10px">Statistiques par moteur</div>
      <div style="font-size:12px;color:var(--muted);margin-bottom:14px">Sur 15 parties de test équitables (général) : le moteur actuel gagne 8, le NNUE gagne 2, 5 nulles — proposé par transparence sur ce qu'on a essayé, pas comme une amélioration mesurée à grande échelle.</div>
      <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:6px">Tes résultats personnels, par moteur choisi</div>
      <div id="engine-stats-personal"></div>
    </div>

    <!-- Profil de decision personnel -- agrege sur toutes les parties
         archivees, chaque coup humain compare a TOUS les coups legaux
         disponibles a cet instant (via le vrai moteur). -->
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px 20px;margin-top:24px">
      <div style="font-size:13px;font-weight:700;color:var(--white);text-transform:uppercase;letter-spacing:1px;margin-bottom:10px">Profil de décision</div>
      <div style="font-size:12px;color:var(--muted);margin-bottom:14px">Pour chaque coup que tu as joué, comparé à tous les coups légaux disponibles à cet instant précis — calculé depuis ton historique de parties, pas une estimation.</div>
      <div id="decision-profile-personal"></div>
    </div>

    <!-- Heatmap d'activite -- calculee depuis getGameHistory(), 12 dernieres semaines. -->
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px 20px;margin-top:24px">
      <div style="font-size:13px;font-weight:700;color:var(--white);text-transform:uppercase;letter-spacing:1px;margin-bottom:10px">Activité</div>
      <div id="activity-heatmap"></div>
    </div>

    <!-- Statistiques d'ejection -- source : moveInfo.ejection par coup,
         rejoue depuis getGameHistory(), meme methode que le profil de
         decision. Formules dans le commentaire de computeEjectionStats(). -->
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px 20px;margin-top:24px">
      <div style="font-size:13px;font-weight:700;color:var(--white);text-transform:uppercase;letter-spacing:1px;margin-bottom:10px">Éjections</div>
      <div id="ejection-stats-personal"></div>
    </div>

    <!-- Noir vs Blanc -- source : humanColor + winner, deja stockes par
         entree de l'historique, lu directement sans rejeu. -->
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px 20px;margin-top:24px">
      <div style="font-size:13px;font-weight:700;color:var(--white);text-transform:uppercase;letter-spacing:1px;margin-bottom:10px">Noir vs Blanc</div>
      <div id="color-stats-personal"></div>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════
     PAGE: ARCHITECTURE -- trois schemas expliquant comment le site est
     construit. Rendus en SVG NATIF, sans bibliotheque externe : charger
     Mermaid (~2 Mo) casserait le fichier unique hors ligne.
     ATTENTION : ces schemas sont ECRITS A LA MAIN et doivent etre mis a
     jour quand l'architecture change -- contrairement a la Fiche pour IA
     qui compte tout a l'execution. Verifies contre le code en v2.39.
══════════════════════════════════════════ -->
<div class="page" id="page-archi">
  <div class="page-header" style="padding-bottom:32px">
    <div class="section-label">Comment c'est construit</div>
    <h2>Architecture</h2>
  </div>
  <div style="padding:0 60px 80px;max-width:760px">
    <div style="font-size:13px;color:var(--muted);margin-bottom:20px">Trois cartes pour comprendre le fonctionnement interne. Version détaillée et à jour : <a href="https://github.com/ocj94/Abalassembly/blob/main/docs/Architecture.md" target="_blank" rel="noopener noreferrer" style="color:var(--gold)">docs/Architecture.md</a> sur le dépôt.</div>
    <div id="archi-diagrams"></div>
  </div>
</div>

<!-- ══════════════════════════════════════════
     PAGE: STATISTIQUES DU JEU (corpus) -- distinctes des statistiques
     PERSONNELLES de la page Stats. Celles-ci portent sur les 4 479
     vraies parties embarquees, pas sur les parties du joueur.
══════════════════════════════════════════ -->
<div class="page" id="page-corpusstats">
  <div class="page-header" style="padding-bottom:32px">
    <div class="section-label">Ce que disent 4 479 vraies parties</div>
    <h2>Statistiques du jeu</h2>
  </div>
  <div style="padding:0 60px 80px;max-width:680px">
    <div style="font-size:13px;color:var(--muted);margin-bottom:20px">Des mesures sur l'Abalone lui-même, calculées à partir des parties réelles embarquées dans le site (MIGS + AbalOnline) — pas sur tes propres parties, qui sont dans <a href="#" onclick="showPage('stats');return false;" style="color:var(--gold)">Statistiques</a>. Chaque chiffre indique sa source.</div>
    <div id="corpus-stats-body"></div>
  </div>
</div>

<!-- ══════════════════════════════════════════
     PAGE: HISTORIQUE DE PARTIES (convertie depuis un modal flottant --
     signale par Olivier : demande une page normale du site, comme les
     autres, plutot qu'une fenetre superposee)
══════════════════════════════════════════ -->
<div class="page" id="page-historique">
  <div class="page-header" style="padding-bottom:32px">
    <div class="section-label">Tes parties</div>
    <h2>Historique</h2>
  </div>
  <div style="padding:0 60px 80px;max-width:680px">
    <div style="font-size:13px;color:var(--muted);margin-bottom:16px">Toutes tes parties terminées, stockées sur cet appareil. Clique « Revoir » pour rejouer coup par coup depuis le début.</div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px" id="historique-filters-host"></div>
    <div id="history-list" style="max-height:none"></div>
    <div style="display:flex;gap:8px;margin-top:20px;flex-wrap:wrap">
      <button onclick="if(confirm('Effacer tout l\'historique de parties ? Irréversible.')){clearGameHistory();_renderHistoryList();}" style="background:none;border:1px solid var(--border);color:var(--muted);border-radius:8px;padding:8px 12px;font-size:12px;cursor:pointer">Vider l'historique</button>
      <button onclick="exportFullHistoryAbaPro()" style="background:none;border:1px solid var(--gold-dim);color:var(--gold);border-radius:8px;padding:8px 12px;font-size:12px;cursor:pointer" title="Un fichier texte en notation Aba-Pro, une partie par bloc, avec date/variante/résultat en en-tête — lisible par tout outil qui comprend cette notation">📤 Exporter tout (Aba-Pro)</button>
      <button onclick="openBulkHistoryImportModal()" style="background:none;border:1px solid var(--border);color:var(--text);border-radius:8px;padding:8px 12px;font-size:12px;cursor:pointer" title="Réimporte un fichier exporté depuis cet appareil ou un autre — les parties déjà présentes ne sont pas dupliquées">📥 Importer</button>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════
     PAGE: GYM CERVEAU
══════════════════════════════════════════ -->
<div class="page" id="page-gym">
  <div class="page-header" style="padding-bottom:32px">
    <div class="section-label">Apprentissage</div>
    <h2>🧠 Gym Cerveau</h2>
    <p style="color:var(--muted);font-size:14px;max-width:640px;margin-top:8px">
      Abalone sollicite plusieurs capacités à la fois : mémoire, repérage visuel, anticipation, contrôle de l'impulsion, changement de plan. Chaque exercice ci-dessous isole l'une d'elles avec une petite tâche mesurable, basée sur de vraies positions et sur le moteur du site.
    </p>
    <div style="padding:12px 16px;background:rgba(200,168,75,0.06);border:1px solid rgba(200,168,75,0.2);border-radius:8px;font-size:12px;color:var(--muted);margin-top:14px;max-width:640px">
      🔒 Ce sont des exercices de jeu, pas un outil médical : ils ne diagnostiquent ni ne traitent rien. Les scores mesurent la performance à l'exercice précis, pas une capacité générale.
    </div>
    <div id="gym-brain-note" style="display:none;font-size:11px;color:var(--muted);margin-top:8px;max-width:640px">
      🧠 Les schémas de cerveau sont illustratifs et simplifiés — pas une image médicale précise, juste un repère visuel de la zone généralement associée à chaque capacité.
    </div>
    <div id="gym-weakness-banner" style="display:none;padding:12px 16px;background:rgba(90,180,140,0.08);border:1px solid rgba(90,180,140,0.25);border-radius:8px;font-size:12px;color:var(--text);margin-top:10px;max-width:640px"></div>
  </div>

  <div class="gym-layout" style="padding:0 60px 80px;display:grid;grid-template-columns:1fr 360px;gap:24px;max-width:1200px">
    <div id="gym-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px;align-content:start"></div>

    <div class="gym-panel" style="background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:18px 20px;position:sticky;top:80px;align-self:start">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
        <div style="font-size:13px;font-weight:700;color:var(--white);text-transform:uppercase;letter-spacing:1px">Exercice en cours</div>
        <div id="gym-exercise-timer" style="font-size:13px;font-weight:700;color:var(--gold);display:none">⏱ 0s</div>
      </div>
      <div style="display:flex;gap:6px;margin-bottom:12px">
        <button type="button" class="gym-level-btn" data-level="1" onclick="gymSetLevel(1)" style="flex:1;font-size:11px;padding:6px 0;background:var(--surface2);color:var(--muted);border:1px solid var(--border);border-radius:6px;cursor:pointer">Facile</button>
        <button type="button" class="gym-level-btn" data-level="2" onclick="gymSetLevel(2)" style="flex:1;font-size:11px;padding:6px 0;background:var(--gold);color:var(--bg);border:1px solid var(--gold);border-radius:6px;cursor:pointer;font-weight:700">Moyen</button>
        <button type="button" class="gym-level-btn" data-level="3" onclick="gymSetLevel(3)" style="flex:1;font-size:11px;padding:6px 0;background:var(--surface2);color:var(--muted);border:1px solid var(--border);border-radius:6px;cursor:pointer">Difficile</button>
        <button type="button" class="gym-level-btn" data-level="4" onclick="gymSetLevel(4)" style="flex:1;font-size:11px;padding:6px 0;background:var(--surface2);color:var(--muted);border:1px solid var(--border);border-radius:6px;cursor:pointer">Expert</button>
      </div>
      <div id="gym-exercise-board" style="min-height:180px;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:12px">Choisis une zone ci-dessus pour commencer.</div>
      <div id="gym-exercise-hint" style="font-size:12px;color:var(--muted);margin-top:12px;min-height:16px"></div>
      <button id="gym-exercise-submit" class="btn" style="display:none;margin-top:12px;width:100%">Valider</button>
      <div id="gym-exercise-result" style="font-size:13px;color:var(--gold);font-weight:700;margin-top:12px;min-height:18px"></div>
      <button id="gym-exercise-replay" class="btn" style="display:none;margin-top:8px;width:100%">🔄 Rejouer</button>
    </div>
  </div>
</div>




<!-- ══════════════════════════════════════════
     PAGE: FORMATION FORMATEURS
════════════════════════════════════════════ -->
<div class="page" id="page-formateurs">
  <div class="page-header" style="padding-bottom:24px">
    <div class="section-label">Progresser</div>
    <h2>Formation Formateurs</h2>
    <p style="color:var(--muted);font-size:15px;margin-top:12px;max-width:620px">Un parcours pour préparer quelqu'un à faire découvrir Abalone à d'autres — enfants ou adultes — en s'appuyant sur les outils réels du site plutôt que sur de la théorie seule.</p>
  </div>

  <div style="padding:0 60px 100px" class="formateur-noprint-pad">
    <div style="background:rgba(200,168,75,0.06);border:1px solid rgba(200,168,75,0.2);border-radius:10px;padding:16px 20px;font-size:13px;color:var(--text);line-height:1.7;max-width:720px;margin-bottom:36px">
      ℹ️ Ce parcours délivre une <strong style="color:var(--gold)">attestation de suivi</strong> à la fin — la preuve que quelqu'un a parcouru ce programme et réussi l'évaluation. Ce n'est <strong>pas</strong> un agrément officiel d'aucune fédération : Abalassembly est un site fichier unique, sans organisme derrière. C'est l'équivalent d'un certificat de fin de cours en ligne, pas d'un diplôme.
    </div>

    <!-- Bascule public -->
    <div style="display:flex;align-items:center;gap:14px;margin-bottom:40px;padding:14px 18px;background:var(--surface);border:1px solid var(--border);border-radius:10px;max-width:480px">
      <span style="font-size:13px;color:var(--muted)">Public visé :</span>
      <div style="display:flex;gap:6px">
        <button type="button" id="formateur-pub-enfants" class="btn-toggle-pub active" onclick="formateurSetPublic('enfants')" style="padding:7px 16px;border-radius:20px;border:1px solid var(--gold-dim);background:rgba(200,168,75,0.12);color:var(--gold);font-size:12px;font-weight:600;cursor:pointer">🧒 Enfants</button>
        <button type="button" id="formateur-pub-adultes" class="btn-toggle-pub" onclick="formateurSetPublic('adultes')" style="padding:7px 16px;border-radius:20px;border:1px solid var(--border);background:transparent;color:var(--muted);font-size:12px;font-weight:600;cursor:pointer">🧑 Tout public</button>
      </div>
    </div>

    <!-- Tronc commun -->
    <div style="margin-bottom:44px">
      <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:16px">Tronc commun</div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;max-width:820px">
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:18px">
          <div style="font-size:20px;margin-bottom:8px">🔷</div>
          <div style="font-size:14px;font-weight:700;color:var(--white);margin-bottom:6px">Le plateau et le but</div>
          <div style="font-size:12.5px;color:var(--muted);line-height:1.6">Plateau hexagonal, 14 billes par joueur. Créé en 1987 par Michel Lalet et Laurent Levi. Le but : éjecter 6 billes adverses.</div>
        </div>
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:18px">
          <div style="font-size:20px;margin-bottom:8px">🤝</div>
          <div style="font-size:14px;font-weight:700;color:var(--white);margin-bottom:6px">Le sumito</div>
          <div style="font-size:12.5px;color:var(--muted);line-height:1.6">3 billes peuvent pousser 1 ou 2 adverses, 2 peuvent en pousser 1 — jamais l'inverse. La règle centrale à faire ressentir avant tout.</div>
        </div>
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:18px">
          <div style="font-size:20px;margin-bottom:8px">🎯</div>
          <div style="font-size:14px;font-weight:700;color:var(--white);margin-bottom:6px">Ta posture de formateur</div>
          <div style="font-size:12.5px;color:var(--muted);line-height:1.6">Faire jouer plus que théoriser. Chaque séance ci-dessous s'appuie sur un outil réel du site — pas une fiche à réciter.</div>
        </div>
      </div>
      <p style="font-size:12.5px;color:var(--muted);margin-top:14px;max-width:720px">Règles complètes et détaillées : <a onclick="showPage('learn')" style="color:var(--gold);cursor:pointer">page Règles du jeu</a> — ce parcours ne les reproduit pas pour éviter que les deux divergent avec le temps.</p>
    </div>

    <!-- Notes par public -->
    <div id="formateur-notes-enfants" class="formateur-pub-notes" style="margin-bottom:36px;padding:16px 20px;background:rgba(200,168,75,0.04);border-left:3px solid var(--gold-dim);border-radius:0 8px 8px 0;max-width:720px">
      <div style="font-size:12px;font-weight:700;color:var(--gold);margin-bottom:6px">🧒 Avec des enfants</div>
      <div style="font-size:13px;color:var(--text);line-height:1.7">Séances courtes (20-30 min), une seule idée par séance. Nommer les billes plutôt que dire "pièce". Laisser perdre contre un enfant plus jeune de temps en temps n'apprend rien — mieux vaut baisser sciemment le niveau et l'annoncer. Le tutoriel interactif du site (bouton "Lancer le tutoriel" en page Règles) fonctionne bien en autonomie après la 1ère séance encadrée.</div>
    </div>
    <div id="formateur-notes-adultes" class="formateur-pub-notes" style="display:none;margin-bottom:36px;padding:16px 20px;background:rgba(200,168,75,0.04);border-left:3px solid var(--gold-dim);border-radius:0 8px 8px 0;max-width:720px">
      <div style="font-size:12px;font-weight:700;color:var(--gold);margin-bottom:6px">🧑 Avec des adultes</div>
      <div style="font-size:13px;color:var(--text);line-height:1.7">Séances de 45-60 min possibles. On peut aller plus vite sur les règles et passer davantage de temps sur les 4 motifs de faiblesse (séance 2) et les finales (séance 5), qui parlent immédiatement à un public habitué à d'autres jeux de stratégie.</div>
    </div>

    <!-- Les 6 séances -->
    <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:16px">Les 6 séances</div>
    <div id="formateur-seances" style="display:flex;flex-direction:column;gap:12px;max-width:820px;margin-bottom:48px"></div>

    <!-- Évaluation -->
    <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:16px">Évaluation</div>
    <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:24px;max-width:720px;margin-bottom:48px">
      <p style="font-size:13px;color:var(--muted);margin:0 0 18px;line-height:1.6">8 questions : règles, reconnaissance des motifs de faiblesse, mises en situation. La question de motif est générée sur une vraie position, comme dans l'exercice Diagnostic de Gym Cerveau — jamais la même deux fois. Seuil de réussite : 6/8.</p>
      <div id="formateur-quiz-body"></div>
      <button id="formateur-quiz-start" class="btn" onclick="formateurQuizStart()" style="margin-top:8px">Commencer l'évaluation</button>
    </div>

    <!-- Attestation -->
    <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:16px">Attestation</div>
    <div id="formateur-attestation-locked" style="background:var(--surface);border:1px dashed var(--border);border-radius:12px;padding:24px;max-width:720px;color:var(--muted);font-size:13px">
      🔒 Réussis l'évaluation (6/8 ou plus) pour débloquer l'attestation imprimable.
    </div>
    <div id="formateur-attestation-unlocked" style="display:none;max-width:720px">
      <div style="display:flex;gap:10px;margin-bottom:16px;align-items:center;flex-wrap:wrap" class="formateur-noprint">
        <input id="formateur-nom" type="text" placeholder="Nom du formateur" style="flex:1;min-width:220px;padding:10px 14px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:13px" oninput="formateurRenderAttestation()">
        <button class="btn" onclick="window.print()">🖨️ Imprimer</button>
      </div>
      <div id="formateur-attestation-card" class="formateur-attestation"></div>
    </div>
  </div>
</div>







