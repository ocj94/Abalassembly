      <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:10px">Comparer avec un ami</div>
      <div style="display:flex;gap:8px;flex-wrap:wrap" id="compare-friends-btns"></div>
    </div>
  </div>
</div>

