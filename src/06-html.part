    </button>
    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-community" onclick="sidebarNav('community',this)">
      <span class="s-icon">👥</span><span class="s-label" data-i18n="nav.community">Communauté</span>
    </button>
    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-tournament" onclick="sidebarNav('tournament',this)">
      <span class="s-icon">⚔️</span><span class="s-label" data-i18n="nav.tournament">Tournoi</span>
    </button>
    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-compare" onclick="sidebarNav('compare',this)">
      <span class="s-icon">⚖️</span><span class="s-label" data-i18n="nav.compare">Comparer</span>
    </button>
    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-friends" onclick="sidebarNav('friends',this)">
      <span class="s-icon">🤝</span><span class="s-label" data-i18n="nav.friends">Amis</span>
    </button>
    </details>

    <!-- Separator -->
    <div class="sidebar-sep"></div>

    <a href="https://onlineabalone.wordpress.com/" target="_blank" rel="noopener noreferrer" class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item">
