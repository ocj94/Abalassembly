<div id="sidebar-overlay" onclick="closeSidebarMobile()"></div>


<!-- ─── PAGE: HOME ─── -->
<div class="page active" id="page-home">
  <!-- ══ BANDEAU D'ENGAGEMENT ══ -->
  <div id="engage-bar" style="padding:20px 60px 0;max-width:1400px;margin:0 auto"></div>

  <section class="hero">
    <div class="hero-text">
      <div style="display:flex;gap:10px;margin-bottom:24px;flex-wrap:wrap">
        <div class="hero-badge" id="hero-stats">100 % hors-ligne · aucun compte requis</div>
        <div class="hero-badge" id="hero-daily" style="background:rgba(74,148,99,0.1);border-color:rgba(74,148,99,0.2);color:var(--accent-green-light);cursor:pointer" onclick="ouvrirDefi()" role="button" tabindex="0" onkeydown="if(event.key==='Enter')ouvrirDefi()">
          🔥 Défi du jour
        </div>
      </div>
      <!-- 3,2,1 Countdown hero -->
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px">
        <div style="font-family:'DM Mono',monospace;font-weight:900;color:var(--gold);display:flex;align-items:flex-end;gap:4px">
          <span style="font-size:36px;opacity:0.5;line-height:1">3</span>
          <span style="font-size:28px;opacity:0.5;line-height:1;margin-bottom:2px">,</span>
          <span style="font-size:30px;opacity:0.65;line-height:1">2</span>
          <span style="font-size:28px;opacity:0.5;line-height:1;margin-bottom:2px">,</span>
          <span style="font-size:24px;opacity:0.8;line-height:1">1</span>
          <span style="font-size:32px;line-height:1;margin-left:2px">…</span>
        </div>
      </div>
      <h1>Maîtrisez<br>l'art de<br><span>l'Abalone !</span></h1>
      <p class="hero-sub">La plateforme de référence pour jouer, apprendre et progresser au jeu de stratégie Abalone. Jouez hors-ligne, contre l'IA ou à deux sur le même appareil — aucune connexion requise.</p>
      <div class="hero-cta">
        <button class="btn-xl gold" onclick="playGame()">🎮 Jouer maintenant</button>
        <button class="btn-xl outline" onclick="showPage('learn')">📖 Apprendre les règles</button>
      </div>
      <p class="hero-libre">Gratuit pour toujours. Sans pub, sans compte obligatoire, sans mesure d’audience. Code ouvert (GPL).</p>
      <!-- Avant : « 48K joueurs actifs · 2.3M parties · 79K sur BGA · 127 pays », non dates, sans
           source precise, et lisibles comme les chiffres de CE site. Remplaces par des chiffres que
           le code permet de verifier (un test les compare au corpus et a la liste des puzzles). -->
      <div class="hero-stats">
        <div class="hero-stats-titre">Abalassembly en chiffres — tous vérifiables</div>
        <div class="stat-item">
          <div class="stat-num" id="hero-nb-parties">4 580</div>
          <div class="stat-label">Vraies parties rejouables</div>
        </div>
        <div class="stat-item">
          <div class="stat-num" id="hero-nb-puzzles">138</div>
          <div class="stat-label">Puzzles tirés de vraies parties</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">100&nbsp;%</div>
          <div class="stat-label">Hors ligne</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">0</div>
          <div class="stat-label">Compte, pub ou mesure d'audience</div>
        </div>
      </div>

      <!-- BGA-style game info bar -->
      <div style="margin-top:28px;padding:18px 22px;background:var(--surface);border:1px solid var(--border);border-radius:12px;display:flex;gap:20px;flex-wrap:wrap;align-items:center">
        <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;flex-basis:100%;margin-bottom:4px">Fiche du jeu — Source: <a href="https://fr.boardgamearena.com/gamepanel?game=abalone" target="_blank" rel="noopener noreferrer" style="color:var(--gold)">Board Game Arena</a></div>
        <div style="display:flex;flex-direction:column;gap:2px">
          <div style="font-size:11px;color:var(--muted)">Stratégie</div>
          <div style="display:flex;gap:3px"><div style="width:14px;height:14px;border-radius:3px;background:var(--gold)"></div><div style="width:14px;height:14px;border-radius:3px;background:var(--gold)"></div><div style="width:14px;height:14px;border-radius:3px;background:var(--gold)"></div><div style="width:14px;height:14px;border-radius:3px;background:var(--gold)"></div><div style="width:14px;height:14px;border-radius:3px;background:var(--gold)"></div></div>
          <div style="font-size:10px;color:var(--gold);font-weight:700">5 / 5</div>
        </div>
        <div style="width:1px;height:36px;background:var(--border)"></div>
        <div style="display:flex;flex-direction:column;gap:2px">
          <div style="font-size:11px;color:var(--muted)">Chance</div>
          <div style="display:flex;gap:3px"><div style="width:14px;height:14px;border-radius:3px;background:var(--surface2);border:1px solid var(--border)"></div><div style="width:14px;height:14px;border-radius:3px;background:var(--surface2);border:1px solid var(--border)"></div><div style="width:14px;height:14px;border-radius:3px;background:var(--surface2);border:1px solid var(--border)"></div><div style="width:14px;height:14px;border-radius:3px;background:var(--surface2);border:1px solid var(--border)"></div><div style="width:14px;height:14px;border-radius:3px;background:var(--surface2);border:1px solid var(--border)"></div></div>
          <div style="font-size:10px;color:var(--muted);font-weight:700">0 / 5</div>
        </div>
        <div style="width:1px;height:36px;background:var(--border)"></div>
        <div style="display:flex;flex-direction:column;gap:2px">
          <div style="font-size:11px;color:var(--muted)">Complexité</div>
          <div style="display:flex;gap:3px">
            <div style="width:14px;height:14px;border-radius:3px;background:var(--accent-green-light)"></div>
            <div style="width:14px;height:14px;border-radius:3px;background:var(--surface2);border:1px solid var(--border)"></div><div style="width:14px;height:14px;border-radius:3px;background:var(--surface2);border:1px solid var(--border)"></div><div style="width:14px;height:14px;border-radius:3px;background:var(--surface2);border:1px solid var(--border)"></div><div style="width:14px;height:14px;border-radius:3px;background:var(--surface2);border:1px solid var(--border)"></div>
          </div>
          <div style="font-size:10px;color:var(--accent-green-light);font-weight:700">1 / 5</div>
        </div>
        <div style="width:1px;height:36px;background:var(--border)"></div>
        <div style="display:flex;flex-direction:column;gap:2px">
          <div style="font-size:11px;color:var(--muted)">Durée</div>
          <div style="font-size:16px;font-weight:700;color:var(--white)">⏱ 20 min</div>
          <div style="font-size:10px;color:var(--muted)">2 joueurs</div>
        </div>
        <div style="width:1px;height:36px;background:var(--border)"></div>
        <div style="display:flex;flex-direction:column;gap:2px">
          <div style="font-size:11px;color:var(--muted)">Auteurs</div>
          <div style="font-size:12px;font-weight:600;color:var(--text)">Michel Lalet</div>
          <div style="font-size:12px;font-weight:600;color:var(--text)">Laurent Levi</div>
        </div>
        <div style="width:1px;height:36px;background:var(--border)"></div>
        <div style="display:flex;flex-direction:column;gap:2px">
          <div style="font-size:11px;color:var(--muted)">Éditeur</div>
          <div style="font-size:13px;font-weight:700;color:var(--white)">Asmodee</div>
          <div style="font-size:10px;color:var(--muted)">Depuis 1987</div>
        </div>
        <div style="margin-left:auto;display:flex;gap:8px;flex-wrap:wrap">
          <a href="https://fr.boardgamearena.com/gamepanel?game=abalone" target="_blank" rel="noopener noreferrer" style="padding:8px 14px;background:none;border:1px solid var(--border);color:var(--text);border-radius:7px;text-decoration:none;font-size:12px;font-family:'DM Sans',sans-serif;display:flex;align-items:center;gap:6px;white-space:nowrap">🎲 Jouer sur BGA</a>
          <a href="https://fr.wikipedia.org/wiki/Abalone_(jeu)" target="_blank" rel="noopener noreferrer" style="padding:8px 14px;background:none;border:1px solid var(--border);color:var(--text);border-radius:7px;text-decoration:none;font-size:12px;font-family:'DM Sans',sans-serif;display:flex;align-items:center;gap:6px;white-space:nowrap">📖 Wikipedia</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="features-section">
    <div class="section-label">Fonctionnalités</div>
    <h2>Tout pour progresser<br>et s'amuser</h2>
    <p class="section-sub">Une plateforme complète, conçue pour les débutants comme les grands maîtres de l'Abalone.</p>
    <div class="features-grid">
      <div class="feature-card feature-upcoming">
        <div class="feature-icon">⚔️</div>
        <div class="feature-title">Matchmaking intelligent<span class="feature-soon">Bientôt</span></div>
        <div class="feature-desc">Un algorithme ELO trouvera l'adversaire idéal à votre niveau pour des parties équilibrées. Disponible avec le jeu en ligne.</div>
      </div>
      <div class="feature-card" onclick="showPage('learn')" style="cursor:pointer">
        <div class="feature-icon">🎓</div>
        <div class="feature-title">Cours interactifs</div>
        <div class="feature-desc">Des tutoriels pas à pas, des puzzles tactiques et des analyses de parties pour progresser efficacement.</div>
      </div>
      <div class="feature-card" onclick="showPage('tournament')" style="cursor:pointer">
        <div class="feature-icon">🏆</div>
        <div class="feature-title">Tournoi mensuel</div>
        <div class="feature-desc">Un parcours en 3 tours contre des IA de force croissante, chaque mois. Solo, entièrement local — disponible dès maintenant, aucun compte requis.</div>
      </div>
      <div class="feature-card" onclick="showPage('analysis')" style="cursor:pointer">
        <div class="feature-icon">📊</div>
        <div class="feature-title">Analyse de parties</div>
        <div class="feature-desc">Revivez chaque coup après la partie. Identifiez vos erreurs et découvrez les meilleurs enchaînements possibles.</div>
      </div>
      <div class="feature-card" onclick="window.open('https://discord.gg/Ju6AZ2vNTN','_blank','noopener')" style="cursor:pointer">
        <div class="feature-icon">🌐</div>
        <div class="feature-title">Communauté mondiale</div>
        <div class="feature-desc">Le classement mondial nécessite un serveur (pas encore déployé). En attendant, rejoins la vraie communauté Abalone sur Discord — parties, discussions, événements. ↗</div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">📱</div>
        <div class="feature-title">Multi-plateforme</div>
        <div class="feature-desc">Jouez depuis votre navigateur, sur ordinateur, téléphone ou tablette. Le jeu fonctionne même hors ligne.</div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="footer-brand">
      <div class="footer-logo" style="display:flex;align-items:center;gap:0">
        <div style="display:flex;align-items:flex-end;gap:2px;margin-right:4px">
          <span style="font-size:10px;font-weight:900;color:var(--gold);font-family:'DM Mono',monospace;opacity:0.6">3,</span>
          <span style="font-size:8px;font-weight:900;color:var(--gold);font-family:'DM Mono',monospace;opacity:0.5">2,</span>
          <span style="font-size:6px;font-weight:900;color:var(--gold);font-family:'DM Mono',monospace;opacity:0.4">1</span>
        </div>
        <div style="display:flex;align-items:flex-end;gap:2px;margin-right:5px">
          <div style="width:9px;height:9px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#888,#111)"></div>
          <div style="width:7px;height:7px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#c8a84b,#7a5a20)"></div>
          <div style="width:5px;height:5px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#fff,#bbb)"></div>
        </div>
        <span style="font-family:'Playfair Display',serif;font-size:22px;font-weight:900;background:linear-gradient(to right,#ffffff 0%,#ffffff 38%,#f0e3c0 50%,#d8b860 70%,#c8a84b 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;color:transparent">ABALASSEMBLY</span>
      </div>
      <p class="footer-desc">Jouer, apprendre et progresser au jeu de stratégie Abalone — hors-ligne, gratuit, sans compte.</p>
