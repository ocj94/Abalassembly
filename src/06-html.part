    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-analysis" onclick="sidebarNav('analysis',this)">
      <span class="s-icon">🔬</span><span class="s-label" data-i18n="nav.analysis">Analyse</span>
