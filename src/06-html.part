    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-github" onclick="sidebarNav('github',this)">
      <span class="s-icon">🔬</span><span class="s-label" data-i18n="nav.github">Insights GitHub</span>
    </button>
    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-archi" onclick="showPage('archi'); if (window.innerWidth < 600 && typeof closeSidebarMobile==='function') closeSidebarMobile();">
      <span class="s-icon">🗺️</span><span class="s-label">Architecture</span>
    </button>
    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-briefing" onclick="openSiteBriefing(); if (window.innerWidth < 600 && typeof closeSidebarMobile==='function') closeSidebarMobile();">
      <span class="s-icon">🤖</span><span class="s-label">Fiche pour IA</span>
    </button>
    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-museum" onclick="sidebarNav('museum',this)">
      <span class="s-icon">🏛</span><span class="s-label" data-i18n="nav.museum">Musée</span>
    </button>
    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-pioneers" onclick="sidebarNav('pioneers',this)">
      <span class="s-icon">🎖️</span><span class="s-label" data-i18n="nav.pioneers">Pionniers</span>
    </button>
    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-trombi" onclick="sidebarNav('trombi',this)">
      <span class="s-icon">🎭</span><span class="s-label" data-i18n="nav.trombi">Trombinoscope</span>
    </button>

    <details class="sidebar-collapse">
      <summary class="sidebar-group-label sidebar-collapse-summary">🌐 En ligne (bientôt) <span class="sidebar-collapse-chevron">▾</span></summary>
    <button class="cc-button-component cc-button-ghost cc-bg-ghost cc-button-large sidebar-item" id="sid-leaderboard" onclick="sidebarNav('leaderboard',this)">
