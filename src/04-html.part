

<!-- ═══════════════════════════════════════════════════════════
     BANDE-ANNONCE D'OUVERTURE — ~6,7 secondes, a la demande d'Olivier : l'EMBLEME
     (hexagone dore et bille, les proportions de l'icone : l'intro prolonge
     l'ecran de demarrage d'Android sans rupture), l'hexagone tourne autour de
     la bille en retrecissant, la bille retrecit avec lui, les deux
     disparaissent ; puis ABALASSEMBLY, puis « Le jeu strategique de
     reference ». Pur CSS/JS, aucune
     dépendance ni fichier vidéo (cohérent avec le mono-fichier).
     Une fois par session (sessionStorage), toujours passable au
     clic/tap/Échap, raccourcie si l'utilisateur préfère moins
     d'animations (prefers-reduced-motion).
     ═══════════════════════════════════════════════════════════ -->
<style>
#intro-splash {
  position: fixed; inset: 0; z-index: 99999;
  background: radial-gradient(ellipse at center, var(--surface) 0%, var(--bg) 100%);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  animation: introFadeOut .6s ease-in 6.0s forwards;
}
#intro-splash.intro-gone { display: none !important; }
.intro-title { position: relative; text-align: center; opacity: 0; animation: introTitleIn .9s ease-out 3.05s forwards; }
/* Emblème : meme taille a l'ecran que l'icone du demarrage d'Android (hexagone
   ~58 % de la largeur), puis l'hexagone tourne d'un tour en retrecissant et la
   bille retrecit avec lui, jusqu'a disparaitre (0,35 -> 2,95 s : disparition
   allongee a la demande d'Olivier). */
.intro-emblem { position: absolute; left: 50%; top: 50%; width: min(66vw, 340px); aspect-ratio: 1; transform: translate(-50%, -50%); pointer-events: none; }
.intro-emblem svg { width: 100%; height: 100%; overflow: visible; display: block; }
.ie-hex, .ie-bille { transform-box: view-box; transform-origin: 100px 100px; }
.ie-hex   { animation: ieHex 2.6s cubic-bezier(.55,0,.75,.45) .35s forwards; }
.ie-bille { animation: ieBille 2.6s cubic-bezier(.55,0,.75,.45) .35s forwards; }
@keyframes ieHex   { from { transform: rotate(0deg) scale(1); opacity: 1; } to { transform: rotate(360deg) scale(0); opacity: 0; } }
@keyframes ieBille { from { transform: scale(1); opacity: 1; } to { transform: scale(0); opacity: 0; } }
.intro-logo {
  font-family: 'Playfair Display', serif; font-size: clamp(32px, 7vw, 64px); font-weight: 700;
  letter-spacing: .04em; color: var(--white);
  background: linear-gradient(120deg, var(--gold-light), var(--gold) 50%, var(--gold-dim));
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  text-shadow: 0 0 40px rgba(200,168,75,.25);
}
@keyframes introTitleIn   { from { opacity:0; transform: translateY(14px) scale(.96); } to { opacity:1; transform: translateY(0) scale(1); } }
.intro-tagline {
  margin-top: 10px; font-family: 'DM Sans', sans-serif; font-size: clamp(12px, 2vw, 15px);
  letter-spacing: .12em; text-transform: uppercase; color: var(--muted); opacity: 0;
  animation: introTaglineIn .8s ease-out 4.05s forwards;   /* apres le titre (3,05 -> 3,95 s) */
}
@keyframes introTaglineIn { from { opacity:0; } to { opacity:1; } }
@keyframes introFadeOut   { to { opacity: 0; visibility: hidden; } }

#intro-skip {
  position: absolute; bottom: 26px; right: 26px; z-index: 2;
  background: transparent; border: 1px solid var(--gold-dim); color: var(--muted);
  font-family: 'DM Sans', sans-serif; font-size: 12px; letter-spacing: .06em;
  padding: 7px 16px; border-radius: 20px; cursor: pointer; opacity: 0;
  animation: introTaglineIn .6s ease-out .8s forwards; transition: color .2s, border-color .2s;
}
#intro-skip:hover { color: var(--gold-light); border-color: var(--gold); }

@media (prefers-reduced-motion: reduce) {
  .intro-title, .intro-tagline, #intro-skip { animation-duration: .01s !important; animation-delay: 0s !important; }
  .intro-emblem { display: none; }
  #intro-splash { animation-delay: 1.2s !important; }
}
</style>
<div id="intro-splash" role="dialog" aria-label="Introduction Abalassembly">
  <div class="intro-emblem" aria-hidden="true">
    <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id="ie-or" cx="50%" cy="50%" r="50%">
          <stop offset="0" stop-color="#e3c672"/><stop offset=".6" stop-color="#ab9452"/><stop offset="1" stop-color="#776335"/>
        </radialGradient>
        <radialGradient id="ie-reflet" cx="50%" cy="50%" r="50%">
          <stop offset="0" stop-color="#ffffff"/><stop offset=".55" stop-color="#fffbea"/><stop offset="1" stop-color="#fff8e1" stop-opacity="0"/>
        </radialGradient>
      </defs>
      <g class="ie-hex"><polygon points="188,100 144,176.2 56,176.2 12,100 56,23.8 144,23.8" fill="none" stroke="#c8a84b" stroke-width="3" stroke-linejoin="miter"/></g>
      <g class="ie-bille"><circle cx="100" cy="100" r="69" fill="url(#ie-or)"/><circle cx="78" cy="72" r="19" fill="url(#ie-reflet)"/></g>
    </svg>
  </div>
  <div class="intro-title">
    <div class="intro-logo">ABALASSEMBLY</div>
    <div class="intro-tagline">Le jeu stratégique de référence</div>
  </div>
  <button id="intro-skip" onclick="skipIntro()">Passer ›</button>
</div>
